 void SmsPlugin::sendSms(const QVariantList &addresses, const QString &textMessage, const QVariantList &attachmentUrls, const qint64 subID)
 {
+    // Callers on other threads (for example a worker that first fetched the
+    // conversation from the phone) have no event loop of ours: run the whole
+    // send on the plugin's thread, where the attachment watcher and
+    // sendPacket work. Dropped if the plugin goes away meanwhile.
+    if (QThread::currentThread() != thread()) {
+        QMetaObject::invokeMethod(
+            this,
+            [this, addresses, textMessage, attachmentUrls, subID]() {
+                sendSms(addresses, textMessage, attachmentUrls, subID);
+            },
+            Qt::QueuedConnection);
+        return;
+    }
+
     QVariantList addressMapList;
     for (const QVariant &address : addresses) {
         QVariantMap addressMap({{QStringLiteral("address"), qdbus_cast<ConversationAddress>(address).address()}});
@@ -239,23 +257,49 @@ void SmsPlugin::sendSms(const QVariantList &addresses, const QString &textMessag
         packetMap[QStringLiteral("subID")] = subID;
     }
 
-    QVariantList attachmentMapList;
-    for (const QVariant &attachmentUrl : attachmentUrls) {
-        const Attachment attachment = createAttachmentFromUrl(attachmentUrl.toString());
-        QVariantMap attachmentMap({{QStringLiteral("fileName"), attachment.uniqueIdentifier()},
-                                   {QStringLiteral("base64EncodedFile"), attachment.base64EncodedFile()},
-                                   {QStringLiteral("mimeType"), attachment.mimeType()}});
-        attachmentMapList.append(attachmentMap);
+    if (attachmentUrls.isEmpty()) {
+        dispatchSmsRequest(packetMap);
+        return;
     }
 
-    // If there is any attachment add it to the network packet
-    if (!attachmentMapList.isEmpty()) {
-        packetMap[QStringLiteral("attachments")] = attachmentMapList;
+    QStringList paths;
+    for (const QVariant &attachmentUrl : attachmentUrls) {
+        paths << attachmentUrl.toString();
     }
 
+    // All images of one message together are re-encoded to fit this many bytes
+    const qint64 imageBudget = config()->getInt(QStringLiteral("mmsImageBudgetBytes"), MmsAttachments::DEFAULT_IMAGE_BUDGET);
+    // Upper limit for one message, text and attachments, before base64
+    const qint64 maxMessage = config()->getInt(QStringLiteral("mmsMaxMessageBytes"), MmsAttachments::DEFAULT_MAX_MESSAGE);
+    const qint64 textBytes = textMessage.toUtf8().size();
+
+    // Reading, scaling and encoding files can take a while; keep the daemon
+    // responsive. The watcher is a child of the plugin, so if the device goes
+    // away meanwhile the result is simply dropped.
+    auto *watcher = new QFutureWatcher<MmsAttachments::Prepared>(this);
+    connect(watcher, &QFutureWatcherBase::finished, this, [this, watcher, packetMap]() mutable {
+        const MmsAttachments::Prepared prepared = watcher->result();
+        watcher->deleteLater();
+        if (!prepared.error.isEmpty()) {
+            qCWarning(KDECONNECT_PLUGIN_SMS) << "Not sending message:" << prepared.error;
+            m_conversationInterface->reportSendFailed(prepared.error);
+            return;
+        }
+        packetMap[QStringLiteral("attachments")] = prepared.attachments;
+        qCDebug(KDECONNECT_PLUGIN_SMS) << "Prepared" << prepared.attachments.size() << "attachments," << prepared.totalBytes << "bytes";
+        dispatchSmsRequest(packetMap);
+    });
+    watcher->setFuture(QtConcurrent::run(&MmsAttachments::prepare, paths, textBytes, imageBudget, maxMessage));
+}
+
+void SmsPlugin::dispatchSmsRequest(QVariantMap packetMap)
