diff --git a/plugins/sms/mmsattachments.cpp b/plugins/sms/mmsattachments.cpp
new file mode 100644
index 0000000..70be223
--- /dev/null
+++ b/plugins/sms/mmsattachments.cpp
@@ -0,0 +1,192 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Alia Holes <thealiaholes@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "mmsattachments.h"
+
+#include <KLocalizedString>
+
+#include <QBuffer>
+#include <QColorSpace>
+#include <QFile>
+#include <QFileInfo>
+#include <QImage>
+#include <QImageReader>
+#include <QImageWriter>
+#include <QMimeDatabase>
+#include <QPainter>
+
+#include <algorithm>
+
+namespace MmsAttachments
+{
+namespace
+{
+// Never upscale, and never go below this on the long side: a smaller image
+// is not worth sending, the user should be told it does not fit instead.
+constexpr int MAX_LONG_SIDE = 1600;
+constexpr int MIN_LONG_SIDE = 240;
+const int QUALITIES[] = {85, 75, 65, 55, 45};
+
+QByteArray encodeJpeg(const QImage &image, int quality)
+{
+    QByteArray bytes;
+    QBuffer buffer(&bytes);
+    buffer.open(QIODevice::WriteOnly);
+    QImageWriter writer(&buffer, "jpeg");
+    writer.setQuality(quality);
+    writer.setOptimizedWrite(true);
+    if (!writer.write(image)) {
+        return QByteArray();
+    }
+    return bytes;
+}
+
+QString jpegName(const QString &path)
+{
+    const QFileInfo info(path);
+    QString base = info.completeBaseName();
+    if (base.isEmpty()) {
+        base = QStringLiteral("image");
+    }
+    return base + QStringLiteral(".jpg");
+}
+}
+
+bool isShrinkableImage(const QString &path, const QString &mimeType)
+{
+    if (!mimeType.startsWith(QLatin1String("image/")) || mimeType == QLatin1String("image/gif")) {
+        return false;
+    }
+    QImageReader reader(path);
+    return reader.canRead();
+}
+
+ShrunkImage shrinkToJpeg(const QString &path, qint64 targetBytes)
+{
+    ShrunkImage result;
+
+    QImageReader reader(path);
+    reader.setAutoTransform(true);
+    const QSize original = reader.size();
+    if (original.isValid() && std::max(original.width(), original.height()) > 2 * MAX_LONG_SIDE) {
+        // Let the decoder skip most of the pixels of a big photo (cheap for JPEG)
+        reader.setScaledSize(original.scaled(2 * MAX_LONG_SIDE, 2 * MAX_LONG_SIDE, Qt::KeepAspectRatio));
+    }
+    QImage decoded = reader.read();
+    if (decoded.isNull()) {
+        result.error = reader.errorString();
+        return result;
+    }
+
+    if (decoded.colorSpace().isValid() && decoded.colorSpace() != QColorSpace(QColorSpace::SRgb)) {
+        decoded.convertToColorSpace(QColorSpace::SRgb);
+    }
+
+    // Paint into a brand-new image: flattens transparency onto white and
+    // leaves every piece of metadata (text keys, colour profile) behind.
+    QImage flat(decoded.size(), QImage::Format_RGB32);
+    flat.fill(Qt::white);
+    {
+        QPainter painter(&flat);
+        painter.drawImage(0, 0, decoded);
+    }
+    decoded = QImage();
+
+    int longSide = std::min(MAX_LONG_SIDE, std::max(flat.width(), flat.height()));
+    QByteArray best;
+    QSize bestSize;
+    while (true) {
+        const QImage scaled = (std::max(flat.width(), flat.height()) > longSide)
+            ? flat.scaled(longSide, longSide, Qt::KeepAspectRatio, Qt::SmoothTransformation)
+            : flat;
+        for (int quality : QUALITIES) {
+            const QByteArray jpeg = encodeJpeg(scaled, quality);
+            if (jpeg.isEmpty()) {
+                result.error = i18n("JPEG encoding failed");
+                return result;
+            }
+            best = jpeg;
+            bestSize = scaled.size();
+            if (jpeg.size() <= targetBytes) {
+                result.ok = true;
+                result.jpeg = jpeg;
+                result.size = bestSize;
+                return result;
+            }
+        }
+        if (longSide <= MIN_LONG_SIDE) {
+            break;
+        }
+        longSide = std::max(MIN_LONG_SIDE, int(longSide * 0.75));
+    }
+
+    result.error = i18n("could not get the image under %1 KB (smallest try was %2 KB at %3x%4)",
+                        targetBytes / 1000,
+                        best.size() / 1000,
+                        bestSize.width(),
+                        bestSize.height());
+    return result;
+}
+
+Prepared prepare(const QStringList &paths, qint64 textBytes, qint64 imageBudget, qint64 maxMessageBytes)
+{
+    Prepared prepared;
+    prepared.totalBytes = textBytes;
+
+    const QMimeDatabase mimeDatabase;
+    QStringList mimeTypes;
+    int imageCount = 0;
+    for (const QString &path : paths) {
+        const QString mimeType = mimeDatabase.mimeTypeForFile(path).name();
+        mimeTypes << mimeType;
+        if (isShrinkableImage(path, mimeType)) {
+            ++imageCount;
+        }
+    }
+    const qint64 perImage = imageCount > 0 ? std::max<qint64>(imageBudget / imageCount, 20 * 1000) : imageBudget;
+
+    for (int i = 0; i < paths.size(); ++i) {
+        const QString &path = paths.at(i);
+        const QString &mimeType = mimeTypes.at(i);
+        QByteArray data;
+        QString fileName;
+        QString sentMimeType = mimeType;
+
+        if (isShrinkableImage(path, mimeType)) {
+            const ShrunkImage image = shrinkToJpeg(path, perImage);
+            if (!image.ok) {
+                prepared.error = QStringLiteral("%1: %2").arg(QFileInfo(path).fileName(), image.error);
+                return prepared;
+            }
+            data = image.jpeg;
+            fileName = jpegName(path);
+            sentMimeType = QStringLiteral("image/jpeg");
+        } else {
+            QFile file(path);
+            if (!file.open(QIODevice::ReadOnly)) {
+                prepared.error = QStringLiteral("%1: %2").arg(QFileInfo(path).fileName(), file.errorString());
+                return prepared;
+            }
+            data = file.readAll();
+            fileName = QFileInfo(path).fileName();
+        }
+
+        prepared.totalBytes += data.size();
+        if (prepared.totalBytes > maxMessageBytes) {
+            prepared.error = i18n("the message is too big to send (%1 KB, the limit is %2 KB)", prepared.totalBytes / 1000, maxMessageBytes / 1000);
+            return prepared;
+        }
+
+        prepared.attachments.append(QVariantMap{
+            {QStringLiteral("fileName"), fileName},
+            {QStringLiteral("base64EncodedFile"), QString::fromLatin1(data.toBase64())},
+            {QStringLiteral("mimeType"), sentMimeType},
+        });
+    }
+
+    return prepared;
+}
+}
diff --git a/plugins/sms/mmsattachments.h b/plugins/sms/mmsattachments.h
new file mode 100644
index 0000000..c6f1397
--- /dev/null
+++ b/plugins/sms/mmsattachments.h
@@ -0,0 +1,62 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Alia Holes <thealiaholes@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QSize>
+#include <QString>
+#include <QStringList>
+#include <QVariantList>
+
+/**
+ * Turning local files into MMS attachments.
+ *
+ * Everything here is free of QObject state so it can run on a worker
+ * thread (QtConcurrent) while the daemon keeps serving D-Bus.
+ */
+namespace MmsAttachments
+{
+/** Default budget for all images of one message together, in bytes */
+constexpr qint64 DEFAULT_IMAGE_BUDGET = 300 * 1000;
+/** Default limit for the whole message (text + attachments, before base64), in bytes */
+constexpr qint64 DEFAULT_MAX_MESSAGE = 600 * 1000;
+
+struct ShrunkImage {
+    bool ok = false;
+    QByteArray jpeg;
+    QSize size;
+    QString error;
+};
+
+/**
+ * Whether the file at @p path is an image we re-encode before sending.
+ * Animated GIFs are left alone (re-encoding would drop the animation).
+ */
+bool isShrinkableImage(const QString &path, const QString &mimeType);
+
+/**
+ * Decode @p path (EXIF orientation applied), convert to sRGB, flatten onto
+ * white, and encode as a baseline JPEG no larger than @p targetBytes,
+ * lowering quality first and then the resolution. The output carries no
+ * metadata (no EXIF, no GPS, no comments). Aspect ratio is kept.
+ */
+ShrunkImage shrinkToJpeg(const QString &path, qint64 targetBytes);
+
+struct Prepared {
+    QVariantList attachments; // maps of {fileName, base64EncodedFile, mimeType}
+    QString error; // non-empty: do not send, tell the user
+    qint64 totalBytes = 0;
+};
+
+/**
+ * Prepare every file in @p paths for a kdeconnect.sms.request packet.
+ * Images share @p imageBudget; other files are sent as they are.
+ * Fails (error set) when a file cannot be read or decoded, or when the
+ * message would still be larger than @p maxMessageBytes.
+ */
+Prepared prepare(const QStringList &paths, qint64 textBytes, qint64 imageBudget, qint64 maxMessageBytes);
+}
