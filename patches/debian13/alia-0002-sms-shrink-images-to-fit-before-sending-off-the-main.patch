+
+#include "plugins/sms/mmsattachments.h"
+
+#include <QBuffer>
+#include <QFile>
+#include <QFileInfo>
+#include <QImage>
+#include <QImageReader>
+#include <QPainter>
+#include <QRandomGenerator>
+#include <QTemporaryDir>
+#include <QTest>
+
+class MmsAttachmentsTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void testBigPhotoShrinksUnderBudget();
+    void testMetadataIsStripped();
+    void testTwoImagesShareTheBudget();
+    void testNonImageKeepsSizeLimit();
+    void testUnreadableFileFails();
+    void testGifIsNotReencoded();
+
+private:
+    QString writePhoto(const QString &name, int width, int height, qint64 minBytes);
+    QTemporaryDir m_dir;
+};
+
+void MmsAttachmentsTest::initTestCase()
+{
+    QVERIFY(m_dir.isValid());
+}
+
+// A photo-like image: smooth gradients plus fine noise, big enough to land
+// around 4 MB as a high-quality JPEG, like a phone camera picture.
+QString MmsAttachmentsTest::writePhoto(const QString &name, int width, int height, qint64 minBytes)
+{
+    QImage image(width, height, QImage::Format_RGB32);
+    QRandomGenerator rng(42);
+    for (int y = 0; y < height; ++y) {
+        QRgb *line = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < width; ++x) {
+            const int noise = int(rng.bounded(64));
+            line[x] = qRgb((x * 255 / width + noise) & 0xff, (y * 255 / height + noise) & 0xff, ((x + y) * 128 / (width + height) + noise) & 0xff);
+        }
+    }
+    image.setText(QStringLiteral("Comment"), QStringLiteral("SECRET-GPS-47.6,-120.0"));
+    const QString path = m_dir.filePath(name);
+    if (!image.save(path, "JPEG", 97)) {
+        return QString();
+    }
+    if (QFileInfo(path).size() < minBytes) {
+        return QString();
+    }
+    return path;
+}
+
+void MmsAttachmentsTest::testBigPhotoShrinksUnderBudget()
+{
+    const QString path = writePhoto(QStringLiteral("photo.jpg"), 4000, 3000, 4 * 1000 * 1000);
+    QVERIFY2(!path.isEmpty(), "could not write a 4 MB test JPEG");
+    qInfo() << "input" << QFileInfo(path).size() << "bytes";
+
+    const MmsAttachments::ShrunkImage shrunk = MmsAttachments::shrinkToJpeg(path, MmsAttachments::DEFAULT_IMAGE_BUDGET);
+    QVERIFY2(shrunk.ok, qPrintable(shrunk.error));
+    qInfo() << "output" << shrunk.jpeg.size() << "bytes" << shrunk.size;
+    QVERIFY(shrunk.jpeg.size() <= MmsAttachments::DEFAULT_IMAGE_BUDGET);
+
+    // Aspect ratio kept (4:3), within a pixel of rounding
+    QVERIFY(qAbs(shrunk.size.width() * 3 - shrunk.size.height() * 4) <= 4);
+
+    // It really is a JPEG that decodes
+    QImage decoded;
+    QVERIFY(decoded.loadFromData(shrunk.jpeg, "JPEG"));
+    QCOMPARE(decoded.size(), shrunk.size);
+}
+
+void MmsAttachmentsTest::testMetadataIsStripped()
+{
+    const QString path = writePhoto(QStringLiteral("tagged.jpg"), 800, 600, 0);
+    QVERIFY(!path.isEmpty());
+    QFile original(path);
+    QVERIFY(original.open(QIODevice::ReadOnly));
+    QVERIFY(original.readAll().contains("SECRET-GPS"));
+
+    const MmsAttachments::ShrunkImage shrunk = MmsAttachments::shrinkToJpeg(path, MmsAttachments::DEFAULT_IMAGE_BUDGET);
+    QVERIFY(shrunk.ok);
+    QVERIFY(!shrunk.jpeg.contains("SECRET-GPS"));
+    QVERIFY(!shrunk.jpeg.contains("Exif"));
+}
+
+void MmsAttachmentsTest::testTwoImagesShareTheBudget()
+{
+    const QString a = writePhoto(QStringLiteral("a.jpg"), 3000, 2000, 0);
+    const QString b = writePhoto(QStringLiteral("b.jpg"), 2000, 3000, 0);
+    QVERIFY(!a.isEmpty() && !b.isEmpty());
+
+    const MmsAttachments::Prepared prepared = MmsAttachments::prepare({a, b}, 10, MmsAttachments::DEFAULT_IMAGE_BUDGET, MmsAttachments::DEFAULT_MAX_MESSAGE);
+    QVERIFY2(prepared.error.isEmpty(), qPrintable(prepared.error));
+    QCOMPARE(prepared.attachments.size(), 2);
+    QVERIFY(prepared.totalBytes <= MmsAttachments::DEFAULT_IMAGE_BUDGET + 10);
+    for (const QVariant &attachment : prepared.attachments) {
+        const QVariantMap map = attachment.toMap();
+        QCOMPARE(map.value(QStringLiteral("mimeType")).toString(), QStringLiteral("image/jpeg"));
+        QVERIFY(map.value(QStringLiteral("fileName")).toString().endsWith(QLatin1String(".jpg")));
+        QVERIFY(!map.value(QStringLiteral("base64EncodedFile")).toString().isEmpty());
+    }
+}
+
+void MmsAttachmentsTest::testNonImageKeepsSizeLimit()
+{
+    const QString path = m_dir.filePath(QStringLiteral("big.bin"));
+    QFile file(path);
+    QVERIFY(file.open(QIODevice::WriteOnly));
+    file.write(QByteArray(700 * 1000, 'x'));
+    file.close();
+
+    const MmsAttachments::Prepared prepared = MmsAttachments::prepare({path}, 0, MmsAttachments::DEFAULT_IMAGE_BUDGET, MmsAttachments::DEFAULT_MAX_MESSAGE);
+    QVERIFY(!prepared.error.isEmpty());
+    QVERIFY(prepared.attachments.isEmpty());
+
+    QFile small(m_dir.filePath(QStringLiteral("small.txt")));
+    QVERIFY(small.open(QIODevice::WriteOnly));
+    small.write("hello");
+    small.close();
+    const MmsAttachments::Prepared ok = MmsAttachments::prepare({small.fileName()}, 0, MmsAttachments::DEFAULT_IMAGE_BUDGET, MmsAttachments::DEFAULT_MAX_MESSAGE);
+    QVERIFY(ok.error.isEmpty());
+    QCOMPARE(ok.attachments.size(), 1);
+    QCOMPARE(QByteArray::fromBase64(ok.attachments.first().toMap().value(QStringLiteral("base64EncodedFile")).toString().toLatin1()), QByteArray("hello"));
+}
+
+void MmsAttachmentsTest::testUnreadableFileFails()
+{
+    const MmsAttachments::Prepared prepared =
+        MmsAttachments::prepare({m_dir.filePath(QStringLiteral("does-not-exist.jpg"))}, 0, MmsAttachments::DEFAULT_IMAGE_BUDGET, MmsAttachments::DEFAULT_MAX_MESSAGE);
+    QVERIFY(!prepared.error.isEmpty());
+    QVERIFY(prepared.attachments.isEmpty());
+}
+
+void MmsAttachmentsTest::testGifIsNotReencoded()
+{
+    const QString path = m_dir.filePath(QStringLiteral("anim.gif"));
+    QImage image(32, 32, QImage::Format_RGB32);
+    image.fill(Qt::red);
+    if (!QImageReader::supportedImageFormats().contains("gif") || !image.save(path, "GIF")) {
+        // Qt cannot write GIF; fake one with the GIF magic so the mime type is right
+        QFile file(path);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        file.write("GIF89a\x01\x00\x01\x00\x00\x00\x00;", 14);
+    }
+    QVERIFY(!MmsAttachments::isShrinkableImage(path, QStringLiteral("image/gif")));
+}
+
+QTEST_MAIN(MmsAttachmentsTest)
+#include "mmsattachmentstest.moc"
