+QString ConversationModel::sendStateText(SendState state, const QString &reason)
+{
+    switch (state) {
+    case Sending:
+        return i18nd("kdeconnect-sms", "Sending…");
+    case Unconfirmed:
+        return i18nd("kdeconnect-sms", "Not confirmed by the phone yet");
+    case Failed:
+        return reason.isEmpty() ? i18nd("kdeconnect-sms", "Not sent") : i18nd("kdeconnect-sms", "Not sent: %1", reason);
+    case Confirmed:
+        break;
+    }
+    return QString();
+}
+
+void ConversationModel::addPendingMessage(const QString &textMessage, int attachmentCount)
+{
+    auto item = new QStandardItem;
+    QString body = textMessage;
+    if (attachmentCount > 0) {
+        const QString attachments = i18ndp("kdeconnect-sms", "(%1 attachment)", "(%1 attachments)", attachmentCount);
+        body = body.isEmpty() ? attachments : body + QLatin1Char('\n') + attachments;
+    }
+    item->setText(body);
+    item->setData(true, FromMeRole);
+    item->setData(QDateTime::currentMSecsSinceEpoch(), DateRole);
+    item->setData(QString(), SenderRole);
+    item->setData(QList<QVariant>(), AttachmentsRole);
+    item->setData(Sending, SendStateRole);
+    item->setData(sendStateText(Sending), SendStateTextRole);
+    // What the phone's copy will carry, to recognise it
+    item->setData(textMessage, Qt::UserRole + 100);
+    item->setData(attachmentCount > 0, Qt::UserRole + 101);
+
+    insertRow(0, item);
+    m_pendingItems.append(item);
+    m_pendingTimer.start();
+}
+
+void ConversationModel::resolvePendingMessage(const ConversationMessage &message)
+{
+    // Only messages written after the pending one was queued can be its copy
+    // (with some slack for the phone's clock); older history with the same
+    // text must not remove it.
+    for (int i = 0; i < m_pendingItems.size(); ++i) {
+        QStandardItem *pending = m_pendingItems.at(i);
+        const qint64 queuedAt = pending->data(DateRole).toLongLong();
+        if (message.date() < queuedAt - 5 * 60 * 1000) {
+            continue;
+        }
+        const QString text = pending->data(Qt::UserRole + 100).toString();
+        const bool hadAttachments = pending->data(Qt::UserRole + 101).toBool();
+        const bool sameText = text.trimmed() == message.body().trimmed();
+        if (sameText && (!hadAttachments || message.containsAttachment() || !text.isEmpty())) {
+            m_pendingItems.removeAt(i);
+            removeRow(pending->row());
+            break;
+        }
+    }
+    if (m_pendingItems.isEmpty()) {
+        m_pendingTimer.stop();
+    }
+}
+
+void ConversationModel::checkPendingMessages()
+{
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    for (QStandardItem *pending : std::as_const(m_pendingItems)) {
+        if (pending->data(SendStateRole).toInt() == Sending && now - pending->data(DateRole).toLongLong() > UNCONFIRMED_AFTER_MS) {
+            pending->setData(Unconfirmed, SendStateRole);
+            pending->setData(sendStateText(Unconfirmed), SendStateTextRole);
+        }
+    }
+}
+
+void ConversationModel::handleMessageSendFailed(const QString &reason)
+{
+    // The daemon does not say which message failed; it can only be one we
+    // queued recently and that is still waiting.
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    for (int i = m_pendingItems.size() - 1; i >= 0; --i) {
+        QStandardItem *pending = m_pendingItems.at(i);
+        if (pending->data(SendStateRole).toInt() != Failed && now - pending->data(DateRole).toLongLong() < UNCONFIRMED_AFTER_MS) {
+            pending->setData(Failed, SendStateRole);
+            pending->setData(sendStateText(Failed, reason), SendStateTextRole);
+            m_pendingItems.removeAt(i);
+            break;
+        }
+    }
+}
+
+bool ConversationModel::adoptThreadOf(const ConversationMessage &message)
+{
+    // A new-conversation page has no thread until the phone creates one;
+    // the first message to or from our recipient is our thread.
+    if (m_threadId != INVALID_THREAD_ID || m_addressList.isEmpty() || message.addresses().isEmpty() || message.isMultitarget()) {
+        return false;
+    }
+    if (!SmsHelper::isPhoneNumberMatch(m_addressList.first().address(), message.addresses().first().address())) {
+        return false;
+    }
+    m_threadId = message.threadID();
+    Q_EMIT threadIdChanged();
+    return true;
+}
+
 void ConversationModel::handleConversationUpdate(const QDBusVariant &msg)
 {
     ConversationMessage message = ConversationMessage::fromDBus(msg);
 
+    adoptThreadOf(message);
+
     if (message.threadID() != m_threadId) {
         // If a conversation which we are not currently viewing was updated, discard the information
         qCDebug(KDECONNECT_SMS_CONVERSATION_MODEL) << "Saw update for thread" << message.threadID() << "but we are currently viewing" << m_threadId;
@@ -198,9 +323,7 @@ void ConversationModel::handleConversationCreated(const QDBusVariant &msg)
 {
     ConversationMessage message = ConversationMessage::fromDBus(msg);
 
-    if (m_threadId == INVALID_THREAD_ID && SmsHelper::isPhoneNumberMatch(m_addressList[0].address(), message.addresses().first().address())
-        && !message.isMultitarget()) {
-        m_threadId = message.threadID();
+    if (adoptThreadOf(message)) {
         createRowFromMessage(message, 0);
     }
 }
