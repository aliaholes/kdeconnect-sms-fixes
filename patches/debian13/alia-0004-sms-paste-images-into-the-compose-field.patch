+SmsHelper::SmsHelper(QObject *parent)
+    : QObject(parent)
+{
+    if (qobject_cast<QGuiApplication *>(QCoreApplication::instance())) {
+        connect(QGuiApplication::clipboard(), &QClipboard::dataChanged, this, &SmsHelper::clipboardChanged);
+    }
+}
+
+namespace
+{
+// Files copied in a file manager, if every one of them is a local image we can send
+QList<QUrl> clipboardImageFiles(const QMimeData *mimeData)
+{
+    if (!mimeData->hasUrls()) {
+        return {};
+    }
+    const QList<QUrl> urls = mimeData->urls();
+    if (urls.isEmpty()) {
+        return {};
+    }
+    for (const QUrl &url : urls) {
+        if (!url.isLocalFile() || !QFileInfo(url.toLocalFile()).isFile() || !SmsHelper::isShrinkableImage(url)) {
+            return {};
+        }
+    }
+    return urls;
+}
+
+// A bitmap (screenshot, "Copy Image"). If text comes with it, the user most
+// likely copied text from a document that also offers a rendering: paste text.
+bool clipboardHasBitmapOnly(const QMimeData *mimeData)
+{
+    return mimeData->hasImage() && !mimeData->hasText();
+}
+}
+
+bool SmsHelper::clipboardPasteable() const
+{
+    if (!qobject_cast<QGuiApplication *>(QCoreApplication::instance())) {
+        return false;
+    }
+    const QMimeData *mimeData = QGuiApplication::clipboard()->mimeData();
+    if (!mimeData) {
+        return false;
+    }
+    return (mimeData->hasText() && !mimeData->text().isEmpty()) || clipboardHasBitmapOnly(mimeData) || !clipboardImageFiles(mimeData).isEmpty();
+}
+
+QString SmsHelper::clipboardText() const
+{
+    const QMimeData *mimeData = QGuiApplication::clipboard()->mimeData();
+    return mimeData && mimeData->hasText() ? mimeData->text() : QString();
+}
+
+QString SmsHelper::pasteDirectory()
+{
+    // The per-user runtime directory (0700, owned by us), never a shared /tmp
+    return QStandardPaths::writableLocation(QStandardPaths::RuntimeLocation) + QStringLiteral("/kdeconnect-sms-paste");
+}
+
+QUrl SmsHelper::savePastedImage(const QImage &image, const QString &dirPath, QString *error)
+{
+    QDir dir(dirPath);
+    if (!dir.mkpath(QStringLiteral("."))) {
+        qWarning() << "Could not create" << dirPath;
+        if (error) {
+            *error = QStringLiteral("cannot create %1").arg(dirPath);
+        }
+        return {};
+    }
+    QFile::setPermissions(dirPath, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+
+    // Pasted images are only needed until the daemon has read them
+    const QDateTime dayAgo = QDateTime::currentDateTime().addDays(-1);
+    const QFileInfoList oldFiles = dir.entryInfoList({QStringLiteral("paste-*.png")}, QDir::Files);
+    for (const QFileInfo &old : oldFiles) {
+        if (old.lastModified() < dayAgo) {
+            QFile::remove(old.absoluteFilePath());
+        }
+    }
+
+    QTemporaryFile file(dir.absoluteFilePath(QStringLiteral("paste-XXXXXX.png")));
+    file.setAutoRemove(false);
+    // Quality 100 = least compression: fast, the daemon re-encodes it anyway
+    if (!file.open() || !image.save(&file, "PNG", 100)) {
+        qWarning() << "Could not save pasted image" << file.fileName() << file.errorString();
+        if (error) {
+            *error = QStringLiteral("cannot write %1: %2").arg(file.fileName().isEmpty() ? dirPath : file.fileName(), file.errorString());
+        }
+        file.remove();
+        return {};
+    }
+    return QUrl::fromLocalFile(file.fileName());
+}
+
+int SmsHelper::pasteClipboardAttachments()
+{
+    const QMimeData *mimeData = QGuiApplication::clipboard()->mimeData();
+    if (!mimeData) {
+        return 0;
+    }
+
+    const int requestId = ++m_lastPasteRequest;
+
+    const QList<QUrl> files = clipboardImageFiles(mimeData);
+    if (!files.isEmpty()) {
+        // Deliver like the bitmap case, after the caller has stored the id
+        QMetaObject::invokeMethod(
+            this,
+            [this, requestId, files]() {
+                Q_EMIT clipboardAttachmentsReady(requestId, files);
+            },
+            Qt::QueuedConnection);
+        return requestId;
+    }
+
+    if (!clipboardHasBitmapOnly(mimeData)) {
+        --m_lastPasteRequest;
+        return 0;
+    }
+    // Reading the clipboard has to happen here; encoding and writing the PNG,
+    // which takes long for a big screenshot, happens off the GUI thread.
+    const QImage image = qvariant_cast<QImage>(mimeData->imageData());
+    if (image.isNull()) {
+        // The clipboard says it holds only an image but it cannot be read: say so,
+        // a paste that does nothing at all looks like a broken app
+        const QString message = i18nd("kdeconnect-sms", "Could not paste the image: the clipboard image could not be read.");
+        QMetaObject::invokeMethod(
+            this,
+            [this, requestId, message]() {
+                Q_EMIT clipboardPasteFailed(requestId, message);
+            },
+            Qt::QueuedConnection);
+        return requestId;
+    }
+    using Saved = std::pair<QUrl, QString>;
+    auto *watcher = new QFutureWatcher<Saved>(this);
+    connect(watcher, &QFutureWatcherBase::finished, this, [this, watcher, requestId]() {
+        const Saved saved = watcher->result();
+        watcher->deleteLater();
+        if (saved.first.isEmpty()) {
+            Q_EMIT clipboardPasteFailed(requestId, i18nd("kdeconnect-sms", "Could not paste the image: %1", saved.second));
+            return;
+        }
+        Q_EMIT clipboardAttachmentsReady(requestId, QList<QUrl>{saved.first});
+    });
+    watcher->setFuture(QtConcurrent::run(
+        [](const QImage &image, const QString &dirPath) {
+            QString error;
+            const QUrl url = savePastedImage(image, dirPath, &error);
+            return Saved(url, error);
+        },
+        image,
+        pasteDirectory()));
+    return requestId;
+}
+
