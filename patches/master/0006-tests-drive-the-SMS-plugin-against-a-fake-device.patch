+/**
+ * A stand-in desktop notification server (org.freedesktop.Notifications) on
+ * the test's session bus, so the test sees what KNotification really shows
+ * and closes. The package tests run under dbus-run-session.
+ */
+class FakeNotificationServer : public QObject
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.freedesktop.Notifications")
+public:
+    QHash<uint, QString> open; // id -> body of every notification currently shown
+    QStringList bodies; // every body ever shown, in order
+    uint nextId = 1;
+
+public Q_SLOTS:
+    QStringList GetCapabilities()
+    {
+        return {QStringLiteral("body"), QStringLiteral("actions"), QStringLiteral("persistence")};
+    }
+    QString GetServerInformation(QString &vendor, QString &version, QString &specVersion)
+    {
+        vendor = QStringLiteral("test");
+        version = QStringLiteral("1");
+        specVersion = QStringLiteral("1.2");
+        return QStringLiteral("fake");
+    }
+    uint Notify(const QString &, uint replacesId, const QString &, const QString &, const QString &body, const QStringList &, const QVariantMap &, int)
+    {
+        const uint id = replacesId ? replacesId : nextId++;
+        open[id] = body;
+        bodies << body;
+        return id;
+    }
+    void CloseNotification(uint id)
+    {
+        if (open.remove(id)) {
+            Q_EMIT NotificationClosed(id, 3); // closed by a call to CloseNotification
+        }
+    }
+
+Q_SIGNALS:
+    void NotificationClosed(uint id, uint reason);
+    void ActionInvoked(uint id, const QString &actionKey);
+};
+
+/**
+ * A link that is up but cannot carry anything: every sendPacket fails.
+ */
+class FailingTestDevice : public TestDevice
+{
+public:
+    using TestDevice::TestDevice;
+    bool sendPacket(NetworkPacket &) override
+    {
+        ++attempts;
+        return false;
+    }
+    int attempts = 0;
+};
+
+/**
+ * Drives the real kdeconnect_sms plugin against a fake device that records
+ * every packet the plugin sends, the way a link to a phone would carry them.
+ */
+class SmsPluginSyncTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void init();
+    void cleanup();
+    void testConnectRequestsConversations();
+    void testHeartbeatIsLightRequest();
+    void testReconnectRequestsAgain();
+    void testSyncStatusOverDbusAdaptor();
+    void testUnreadableAttachmentReportsFailure();
+    void testImageIsShrunkBeforeSending();
+    void testSendFromWorkerThread();
+    void testStallNotifiedOncePerEpisodeAndCleared();
+    void testFastLinkFlapNotifies();
+    void testEverySendFailingNotifies();
+    void testDisconnectClosesStallNotification();
+
+private:
+    int syncState();
+    QImage makePhoto();
+    KdeConnectPlugin *loadPlugin();
+    KdeConnectPlugin *loadPluginFor(Device *device);
+    void configure(Device *device);
+    QObject *conversationsAdaptor();
+    void feedMessage(qint64 threadId);
+
+    TestDevice *m_device = nullptr;
+    KdeConnectPlugin *m_plugin = nullptr;
+    FakeNotificationServer *m_notifications = nullptr;
+    QTemporaryDir m_dir;
+};
+
+void SmsPluginSyncTest::initTestCase()
+{
+    QStandardPaths::setTestModeEnabled(true);
+    QVERIFY(m_dir.isValid());
+    // KNotification drops an event it has no config for at once; give it ours
+    // (test-mode data dir) so the notification lives until the plugin closes it
+    const QString knotifyDir = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) + QStringLiteral("/knotifications6");
+    QVERIFY(QDir().mkpath(knotifyDir));
+    QFile::remove(knotifyDir + QStringLiteral("/kdeconnect.notifyrc"));
+    QVERIFY(QFile::copy(QStringLiteral(KDECONNECT_NOTIFYRC_PATH), knotifyDir + QStringLiteral("/kdeconnect.notifyrc")));
+
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (bus.isConnected() && !bus.interface()->isServiceRegistered(QStringLiteral("org.freedesktop.Notifications"))) {
+        auto *server = new FakeNotificationServer;
+        server->setParent(this);
+        if (bus.registerObject(QStringLiteral("/org/freedesktop/Notifications"), server, QDBusConnection::ExportAllSlots | QDBusConnection::ExportAllSignals)
+            && bus.registerService(QStringLiteral("org.freedesktop.Notifications"))) {
+            m_notifications = server;
+        }
+    }
+    qInfo() << "fake notification server:" << (m_notifications ? "on the session bus" : "none (no session bus)");
+}
+
+void SmsPluginSyncTest::configure(Device *device)
+{
+    // One-second heartbeat so the test does not wait five minutes
+    KdeConnectPluginConfig config(device->id(), QStringLiteral("kdeconnect_sms"));
+    config.set(QStringLiteral("syncHeartbeatSeconds"), 1);
+    // and a one-second answer window so staleness shows up within the test
+    config.set(QStringLiteral("syncStaleSeconds"), 1);
+}
+
+void SmsPluginSyncTest::init()
+{
+    // The sync clock outlives the plugin (per device, for the daemon's lifetime):
+    // one device per test, so no test inherits another's unanswered requests
+    m_device = new TestDevice(nullptr, QStringLiteral("smssynctest_%1").arg(QLatin1String(QTest::currentTestFunction())));
+    configure(m_device);
+    m_plugin = loadPlugin();
+    QVERIFY(m_plugin);
+}
+
+void SmsPluginSyncTest::cleanup()
+{
+    delete m_plugin;
+    m_plugin = nullptr;
+    delete m_device;
+    m_device = nullptr;
+}
+
+KdeConnectPlugin *SmsPluginSyncTest::loadPlugin()
+{
+    return loadPluginFor(m_device);
+}
+
+KdeConnectPlugin *SmsPluginSyncTest::loadPluginFor(Device *device)
+{
+    const KPluginMetaData data(QStringLiteral(KDECONNECT_SMS_PLUGIN_PATH));
+    if (!data.isValid()) {
+        qWarning() << "invalid plugin metadata" << KDECONNECT_SMS_PLUGIN_PATH;
+        return nullptr;
+    }
+    const QStringList outgoing = data.value(QStringLiteral("X-KdeConnect-OutgoingPacketType"), QStringList());
+    const QVariantList args{QVariant::fromValue<Device *>(device), QStringLiteral("kdeconnect_sms"), outgoing, data.iconName()};
+    auto result = KPluginFactory::instantiatePlugin<KdeConnectPlugin>(data, device, args);
+    if (!result) {
+        qWarning() << result.errorText;
+    }
+    return result.plugin;
+}
+
+QObject *SmsPluginSyncTest::conversationsAdaptor()
+{
+    // Every plugin instance adds its adaptor to the device; QtDBus serves the
+    // newest one for the interface, so that is the one the SMS app talks to
+    QObject *newest = nullptr;
+    const auto adaptors = m_device->findChildren<QDBusAbstractAdaptor *>();
+    for (QDBusAbstractAdaptor *adaptor : adaptors) {
+        if (QLatin1String(adaptor->metaObject()->className()) == QLatin1String("ConversationsDbusInterface")) {
+            newest = adaptor;
+        }
+    }
+    return newest;
+}
+
+void SmsPluginSyncTest::feedMessage(qint64 threadId)
+{
+    const QVariantMap message{
+        {QStringLiteral("event"), 1},
+        {QStringLiteral("body"), QStringLiteral("hello")},
+        {QStringLiteral("addresses"), QVariantList{QVariantMap{{QStringLiteral("address"), QStringLiteral("+15095550100")}}}},
+        {QStringLiteral("date"), QDateTime::currentMSecsSinceEpoch()},
+        {QStringLiteral("type"), 1},
+        {QStringLiteral("read"), 1},
+        {QStringLiteral("thread_id"), threadId},
+        {QStringLiteral("_id"), 7},
+    };
+    NetworkPacket np(QStringLiteral("kdeconnect.sms.messages"), {{QStringLiteral("version"), 2}, {QStringLiteral("messages"), QVariantList{message}}});
+    m_plugin->receivePacket(np);
+}
+
+void SmsPluginSyncTest::testConnectRequestsConversations()
+{
+    QCOMPARE(m_device->getSentPackets(), 0);
+    m_plugin->connected();
+    QCOMPARE(m_device->getSentPackets(), 1);
+    QCOMPARE(m_device->getLastPacket()->type(), QStringLiteral("kdeconnect.sms.request_conversations"));
+}
+
+void SmsPluginSyncTest::testHeartbeatIsLightRequest()
+{
+    m_plugin->connected();
+    feedMessage(42);
+    const int before = m_device->getSentPackets();
+    QTRY_VERIFY_WITH_TIMEOUT(m_device->getSentPackets() > before, 3000);
+    NetworkPacket *np = m_device->getLastPacket();
+    QCOMPARE(np->type(), QStringLiteral("kdeconnect.sms.request_conversation"));
+    QCOMPARE(np->get<qint64>(QStringLiteral("threadID")), qint64(42));
+    QCOMPARE(np->get<qint64>(QStringLiteral("numberToRequest")), qint64(1));
+}
+
+void SmsPluginSyncTest::testReconnectRequestsAgain()
+{
+    m_plugin->connected();
+    QCOMPARE(m_device->getLastPacket()->type(), QStringLiteral("kdeconnect.sms.request_conversations"));
+    // Device::reloadPlugins destroys the plugin when the link drops and makes a new one when it is back
+    delete m_plugin;
+    m_plugin = loadPlugin();
+    QVERIFY(m_plugin);
+    const int before = m_device->getSentPackets();
+    m_plugin->connected();
+    QCOMPARE(m_device->getSentPackets(), before + 1);
+    QCOMPARE(m_device->getLastPacket()->type(), QStringLiteral("kdeconnect.sms.request_conversations"));
+}
+
+void SmsPluginSyncTest::testSyncStatusOverDbusAdaptor()
+{
+    QObject *adaptor = conversationsAdaptor();
+    QVERIFY(adaptor);
+    QSignalSpy status(adaptor, SIGNAL(syncStatusChanged()));
+    m_plugin->connected();
+    QVERIFY(status.count() >= 1);
+
+    qlonglong lastRequest = 0;
+    qlonglong lastReply = 0;
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "lastSyncRequest", Q_RETURN_ARG(qlonglong, lastRequest)));
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "lastSyncReply", Q_RETURN_ARG(qlonglong, lastReply)));
+    QVERIFY(lastRequest > 0);
+    QVERIFY(lastReply < lastRequest); // asked, not answered yet: the app shows this as stale after a while
+
+    QVariantMap sync;
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "syncStatus", Q_RETURN_ARG(QVariantMap, sync)));
+    QCOMPARE(sync.value(QStringLiteral("unansweredSince")).toLongLong(), lastRequest);
+    QVERIFY(sync.value(QStringLiteral("connectedSince")).toLongLong() > 0);
+    QCOMPARE(sync.value(QStringLiteral("staleAfter")).toLongLong(), qint64(1000));
+
+    feedMessage(42);
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "lastSyncReply", Q_RETURN_ARG(qlonglong, lastReply)));
+    QVERIFY(lastReply >= lastRequest);
+    QCOMPARE(syncState(), 1); // SmsSyncStatus::Answered
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "syncStatus", Q_RETURN_ARG(QVariantMap, sync)));
+    QCOMPARE(sync.value(QStringLiteral("unansweredSince")).toLongLong(), qint64(0));
+}
+
+void SmsPluginSyncTest::testUnreadableAttachmentReportsFailure()
+{
+    QObject *adaptor = conversationsAdaptor();
+    QVERIFY(adaptor);
+    QSignalSpy failed(adaptor, SIGNAL(messageSendFailed(QString)));
+    const int before = m_device->getSentPackets();
+    QVERIFY(QMetaObject::invokeMethod(m_plugin,
+                                      "sendSms",
+                                      Q_ARG(QVariantList, QVariantList()),
+                                      Q_ARG(QString, QStringLiteral("hi")),
+                                      Q_ARG(QVariantList, QVariantList{m_dir.filePath(QStringLiteral("missing.jpg"))}),
+                                      Q_ARG(qint64, -1)));
+    QVERIFY(failed.wait(5000));
+    QVERIFY(!failed.first().first().toString().isEmpty());
+    QCOMPARE(m_device->getSentPackets(), before); // nothing half-built went out
+}
+
+int SmsPluginSyncTest::syncState()
+{
+    QVariantMap sync;
+    if (!QMetaObject::invokeMethod(conversationsAdaptor(), "syncStatus", Q_RETURN_ARG(QVariantMap, sync))) {
+        return -1;
+    }
+    return sync.value(QStringLiteral("state")).toInt();
+}
+
+QImage SmsPluginSyncTest::makePhoto()
+{
+    QImage image(4000, 3000, QImage::Format_RGB32);
+    for (int y = 0; y < image.height(); ++y) {
+        QRgb *line = reinterpret_cast<QRgb *>(image.scanLine(y));
+        for (int x = 0; x < image.width(); ++x) {
+            line[x] = qRgb((x ^ y) & 0xff, (x * 7) & 0xff, (y * 3) & 0xff);
+        }
+    }
+    return image;
+}
+
+void SmsPluginSyncTest::testImageIsShrunkBeforeSending()
+{
+    const QImage image = makePhoto();
+    const QString path = m_dir.filePath(QStringLiteral("photo.jpg"));
+    QVERIFY(image.save(path, "JPEG", 97));
+    QVERIFY(QFileInfo(path).size() > 600 * 1000); // the old desktop refused this outright
+
+    const int before = m_device->getSentPackets();
+    QVERIFY(QMetaObject::invokeMethod(m_plugin,
+                                      "sendSms",
+                                      Q_ARG(QVariantList, QVariantList()),
+                                      Q_ARG(QString, QStringLiteral("look")),
+                                      Q_ARG(QVariantList, QVariantList{path}),
+                                      Q_ARG(qint64, -1)));
+    // The work runs on a worker thread; the event loop stays free meanwhile
+    QTRY_VERIFY_WITH_TIMEOUT(m_device->getSentPackets() > before, 20000);
+    NetworkPacket *np = m_device->getLastPacket();
+    QCOMPARE(np->type(), QStringLiteral("kdeconnect.sms.request"));
+    const QVariantList attachments = np->get<QVariantList>(QStringLiteral("attachments"));
+    QCOMPARE(attachments.size(), 1);
+    const QVariantMap attachment = attachments.first().toMap();
+    QCOMPARE(attachment.value(QStringLiteral("mimeType")).toString(), QStringLiteral("image/jpeg"));
+    const QByteArray jpeg = QByteArray::fromBase64(attachment.value(QStringLiteral("base64EncodedFile")).toString().toLatin1());
+    qInfo() << "input" << QFileInfo(path).size() << "bytes, sent" << jpeg.size() << "bytes";
+    QVERIFY(jpeg.size() <= 300 * 1000);
+    QImage sent;
+    QVERIFY(sent.loadFromData(jpeg, "JPEG"));
+    QVERIFY(qAbs(sent.width() * 3 - sent.height() * 4) <= 4);
+}
+
+void SmsPluginSyncTest::testSendFromWorkerThread()
+{
+    // conversationsdbusinterface's cache-miss reply path calls sendSms from a
+    // QThread::create worker that has no event loop. The message (with a
+    // photo, which needs the attachment watcher) must still go out.
+    const QString path = m_dir.filePath(QStringLiteral("worker-photo.jpg"));
+    QVERIFY(makePhoto().save(path, "JPEG", 97));
+    const int before = m_device->getSentPackets();
+    bool invoked = false;
+    QThread *worker = QThread::create([this, path, &invoked]() {
+        invoked = QMetaObject::invokeMethod(m_plugin,
+                                            "sendSms",
+                                            Qt::DirectConnection,
+                                            Q_ARG(QVariantList, QVariantList()),
+                                            Q_ARG(QString, QStringLiteral("from a worker")),
+                                            Q_ARG(QVariantList, QVariantList{path}),
+                                            Q_ARG(qint64, -1));
+    });
+    worker->start();
+    QVERIFY(worker->wait(5000));
+    delete worker;
+    QVERIFY(invoked);
+    QTRY_VERIFY_WITH_TIMEOUT(m_device->getSentPackets() > before, 20000);
+    NetworkPacket *np = m_device->getLastPacket();
+    QCOMPARE(np->type(), QStringLiteral("kdeconnect.sms.request"));
+    QCOMPARE(np->get<QString>(QStringLiteral("messageBody")), QStringLiteral("from a worker"));
+    QCOMPARE(np->get<QVariantList>(QStringLiteral("attachments")).size(), 1);
+
+    // and a text-only message from a worker goes out too
+    const int beforeText = m_device->getSentPackets();
+    QThread *textWorker = QThread::create([this]() {
+        QMetaObject::invokeMethod(m_plugin,
+                                  "sendSms",
+                                  Qt::DirectConnection,
+                                  Q_ARG(QVariantList, QVariantList()),
+                                  Q_ARG(QString, QStringLiteral("text from a worker")),
+                                  Q_ARG(QVariantList, QVariantList()),
+                                  Q_ARG(qint64, -1));
+    });
+    textWorker->start();
+    QVERIFY(textWorker->wait(5000));
+    delete textWorker;
+    QTRY_VERIFY_WITH_TIMEOUT(m_device->getSentPackets() > beforeText, 5000);
+    QCOMPARE(m_device->getLastPacket()->get<QString>(QStringLiteral("messageBody")), QStringLiteral("text from a worker"));
+}
+
+void SmsPluginSyncTest::testStallNotifiedOncePerEpisodeAndCleared()
+{
+    // Earlier tests may have left this device stale; a reply starts us clean
+    m_plugin->connected();
+    feedMessage(42);
+    QCOMPARE(syncState(), 1); // Answered
+
+    QSignalSpy notified(m_plugin, SIGNAL(syncStallNotified(bool)));
+    // The phone goes silent: heartbeats go out every second, nothing comes back
+    QTRY_COMPARE_WITH_TIMEOUT(notified.count(), 1, 5000);
+    QCOMPARE(notified.first().first().toBool(), true);
+    QCOMPARE(syncState(), 4); // Stale
+
+    // Several more unanswered heartbeats: still one notification, and the
+    // state over D-Bus never drops out of the warning
+    for (int i = 0; i < 16; ++i) {
+        QTest::qWait(200);
+        QCOMPARE(syncState(), 4);
+    }
+    QCOMPARE(notified.count(), 1);
+    QVERIFY(m_device->getSentPackets() >= 4);
+
+    // The phone answers: the notification is taken away
+    feedMessage(42);
+    QCOMPARE(notified.count(), 2);
+    QCOMPARE(notified.last().first().toBool(), false);
+    QCOMPARE(syncState(), 1);
+
+    // A reconnect where the phone never answers: a new episode, its own state
+    delete m_plugin;
+    m_plugin = loadPlugin();
+    QVERIFY(m_plugin);
+    QSignalSpy notifiedAgain(m_plugin, SIGNAL(syncStallNotified(bool)));
+    QTest::qWait(20); // the link comes up after the last answer, not in the same millisecond
+    m_plugin->connected();
+    QCOMPARE(syncState(), 2); // Waiting: the answer from before does not count for this link
+    QTRY_COMPARE_WITH_TIMEOUT(notifiedAgain.count(), 1, 5000);
+    QCOMPARE(syncState(), 3); // NeverAnswered
+    feedMessage(42);
+    QCOMPARE(notifiedAgain.count(), 2);
+}
+
+void SmsPluginSyncTest::testFastLinkFlapNotifies()
+{
+    // The link drops and comes back every 0.4 s, faster than the 1 s window,
+    // and the phone never answers. Every drop destroys the plugin and every
+    // link-up makes a new one (Device::reloadPlugins). The warning and the
+    // notification must still come.
+    int shown = 0;
+    int lastState = -1;
+    for (int cycle = 0; cycle < 12 && shown == 0; ++cycle) {
+        if (!m_plugin) {
+            m_plugin = loadPlugin();
+            QVERIFY(m_plugin);
+        }
+        QSignalSpy notified(m_plugin, SIGNAL(syncStallNotified(bool)));
+        m_plugin->connected();
+        QTest::qWait(400);
+        lastState = syncState();
+        for (const QList<QVariant> &args : std::as_const(notified)) {
+            if (args.first().toBool()) {
+                ++shown;
+            }
+        }
+        if (shown == 0) {
+            delete m_plugin;
+            m_plugin = nullptr;
+            QTest::qWait(20); // disconnected for a moment
+        }
+    }
+    QVERIFY2(shown == 1, "a link flapping faster than the window never raised the notification");
+    QCOMPARE(lastState, 3); // NeverAnswered
+}
+
+void SmsPluginSyncTest::testEverySendFailingNotifies()
+{
+    // A link that is up but where every sendPacket fails: nothing goes out,
+    // nothing comes back, and the user must be told
+    delete m_plugin;
+    m_plugin = nullptr;
+    FailingTestDevice failing(nullptr, QStringLiteral("smssynctest_failingdevice"));
+    configure(&failing);
+    KdeConnectPlugin *plugin = loadPluginFor(&failing);
+    QVERIFY(plugin);
+    QSignalSpy notified(plugin, SIGNAL(syncStallNotified(bool)));
+    plugin->connected();
+    QVERIFY(failing.attempts >= 1);
+    QTRY_COMPARE_WITH_TIMEOUT(notified.count(), 1, 5000);
+    QCOMPARE(notified.first().first().toBool(), true);
+
+    QObject *adaptor = nullptr;
+    const auto adaptors = failing.findChildren<QDBusAbstractAdaptor *>();
+    for (QDBusAbstractAdaptor *a : adaptors) {
+        if (QLatin1String(a->metaObject()->className()) == QLatin1String("ConversationsDbusInterface")) {
+            adaptor = a;
+        }
+    }
+    QVERIFY(adaptor);
+    QVariantMap sync;
+    QVERIFY(QMetaObject::invokeMethod(adaptor, "syncStatus", Q_RETURN_ARG(QVariantMap, sync)));
+    QCOMPARE(sync.value(QStringLiteral("state")).toInt(), 3); // NeverAnswered
+    QVERIFY(sync.value(QStringLiteral("unansweredSince")).toLongLong() > 0);
+    QCOMPARE(sync.value(QStringLiteral("lastRequest")).toLongLong(), qint64(0)); // nothing was ever actually asked
+    QTest::qWait(1500);
+    QVERIFY(failing.attempts >= 2); // the heartbeat keeps trying
+    QCOMPARE(notified.count(), 1); // one notification for the episode
+    delete plugin;
+}
+
+void SmsPluginSyncTest::testDisconnectClosesStallNotification()
+{
+    QSignalSpy created(m_plugin, SIGNAL(syncStallNotificationCreated(QObject *)));
+    QSignalSpy notified(m_plugin, SIGNAL(syncStallNotified(bool)));
+    m_plugin->connected();
+    QTRY_COMPARE_WITH_TIMEOUT(created.count(), 1, 5000);
+    QPointer<QObject> notification = created.first().first().value<QObject *>();
+    QVERIFY(notification);
+    QCOMPARE(notified.count(), 1);
+    if (m_notifications) {
+        // really on screen: the desktop's notification server got it
+        QTRY_COMPARE_WITH_TIMEOUT(m_notifications->open.size(), 1, 3000);
+        QVERIFY(m_notifications->open.begin().value().contains(QStringLiteral("not updating")));
+    }
+
+    // The phone disconnects: the plugin goes away. The persistent notification
+    // must not stay behind saying something about a phone we no longer talk to.
+    delete m_plugin;
+    m_plugin = nullptr;
+    QCOMPARE(notified.count(), 2);
+    QCOMPARE(notified.last().first().toBool(), false);
+    if (m_notifications) {
+        // and it is really gone from the screen
+        QTRY_COMPARE_WITH_TIMEOUT(m_notifications->open.size(), 0, 3000);
+    } else {
+        qWarning() << "no session bus: only the plugin's own bookkeeping was checked";
+    }
+
+    // It comes back and still does not answer: the episode logic decides afresh
+    QTest::qWait(300);
+    m_plugin = loadPlugin();
+    QVERIFY(m_plugin);
+    QSignalSpy createdAgain(m_plugin, SIGNAL(syncStallNotificationCreated(QObject *)));
+    QSignalSpy notifiedAgain(m_plugin, SIGNAL(syncStallNotified(bool)));
+    m_plugin->connected();
+    // The clock carried over (minus the disconnected time), so it warns again soon
+    QTRY_COMPARE_WITH_TIMEOUT(createdAgain.count(), 1, 5000);
+    QCOMPARE(notifiedAgain.first().first().toBool(), true);
+    QCOMPARE(syncState(), 3);
+    uint shownId = 0;
+    if (m_notifications) {
+        QTRY_COMPARE_WITH_TIMEOUT(m_notifications->open.size(), 1, 3000);
+        shownId = m_notifications->open.begin().key();
+    }
+    // and a reply takes it away (the 1 s test window can start a new episode
+    // right after, so watch this one notification)
+    feedMessage(42);
+    QCOMPARE(notifiedAgain.count(), 2);
+    QCOMPARE(syncState(), 1);
+    if (m_notifications) {
+        QTRY_VERIFY_WITH_TIMEOUT(!m_notifications->open.contains(shownId), 3000);
+    }
+}
+
