+#include "plugins/sms/smssynckeeper.h"
+#include "plugins/sms/smssyncstatus.h"
+#include "smsapp/smshelper.h"
+
+#include <QSignalSpy>
+#include <QTest>
+
+#include <memory>
+
+/**
+ * What the SMS app shows, driven through the daemon's SmsSyncKeeper with a
+ * fake clock: the app evaluates SmsSyncStatus::evaluate() on the times the
+ * daemon publishes and turns the state into SmsHelper::syncStatusText(),
+ * exactly as ConversationListModel::updateSyncStatusText() does.
+ *
+ * The bug this guards against: every unanswered heartbeat used to move the
+ * "last request" time, so the warning showed for 3 of every 5 minutes and
+ * nothing at all was shown when the phone had never answered.
+ */
+class SmsSyncStatusTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testNeverAnsweredWarningStaysUp();
+    void testStoppedAnsweringWarningStaysUpUntilReply();
+    void testHealthyPhoneNeverWarns();
+    void testReconnectGivesAFreshWindow();
+    void testWordingSaysWhatTheTimeMeans();
+    void testFastLinkFlapStillWarns();
+    void testPhoneThatWasAwayGetsItsWindow();
+    void testDebouncedLinkUpNeverReadsAnswered();
+    void testFailedSendsCountAsNotSyncing();
+
+private:
+    struct Sample {
+        qint64 t;
+        int state;
+        QString text;
+    };
+    // The app's view of the keeper at the current fake time
+    Sample appView(const SmsSyncKeeper &keeper) const
+    {
+        const int state = SmsSyncStatus::evaluate(m_now,
+                                                  keeper.unansweredSinceMs(),
+                                                  keeper.lastReplyMs(),
+                                                  keeper.connectedSinceMs(),
+                                                  keeper.staleAfterMs(),
+                                                  keeper.unansweredPausedMs());
+        return {m_now, state, SmsHelper::syncStatusText(state, keeper.lastReplyMs(), keeper.unansweredSinceMs(), keeper.connectedSinceMs())};
+    }
+    // Advance the fake clock in 15 s steps (the app's re-check interval), running the
+    // 5 min heartbeat when it is due, and sample what the app would show at each step.
+    QList<Sample> run(SmsSyncKeeper &keeper, qint64 forMs)
+    {
+        QList<Sample> samples;
+        const qint64 end = m_now + forMs;
+        while (m_now < end) {
+            m_now += 15 * 1000;
+            if (m_now - m_lastBeat >= HEARTBEAT_MS) {
+                m_lastBeat = m_now;
+                keeper.heartbeat();
+            }
+            keeper.checkState();
+            samples << appView(keeper);
+        }
+        return samples;
+    }
+    void makeKeeper(SmsSyncKeeper &keeper, bool answers)
+    {
+        keeper.setClock([this]() {
+            return m_now;
+        });
+        keeper.setNewestThreadProvider([]() {
+            return qint64(42);
+        });
+        keeper.setFullSyncIntervalMs(30 * 60 * 1000);
+        m_answers = answers;
+        auto request = [this, &keeper]() {
+            keeper.noteRequest();
+            if (m_answers) {
+                keeper.noteReply();
+            }
+        };
+        connect(&keeper, &SmsSyncKeeper::wantFullSync, &keeper, request);
+        connect(&keeper, &SmsSyncKeeper::wantLightSync, &keeper, request);
+    }
+
+    static constexpr qint64 HEARTBEAT_MS = 5 * 60 * 1000;
+    static constexpr qint64 START = 1762560000000; // a fixed day, so times format the same way
+    qint64 m_now = START;
+    qint64 m_lastBeat = START;
+    bool m_answers = true;
+};
+
+void SmsSyncStatusTest::testNeverAnsweredWarningStaysUp()
+{
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper keeper(0); // heartbeat driven by hand
+    makeKeeper(keeper, false);
+    QSignalSpy states(&keeper, &SmsSyncKeeper::stateChanged);
+
+    keeper.linkUp();
+    const qint64 connected = m_now;
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::Waiting));
+    QVERIFY(!appView(keeper).text.isEmpty()); // visible from the first second, never blank
+
+    // Forty minutes, eight unanswered heartbeats
+    const QList<Sample> samples = run(keeper, 40 * 60 * 1000);
+    int warnings = 0;
+    for (const Sample &s : samples) {
+        QVERIFY2(!s.text.isEmpty(), qPrintable(QStringLiteral("blank status at +%1 s").arg((s.t - connected) / 1000)));
+        if (s.t - connected < SmsSyncStatus::DEFAULT_STALE_AFTER_MS) {
+            QCOMPARE(s.state, int(SmsSyncStatus::Waiting));
+        } else {
+            // Continuous from the end of the window on: no gap after any heartbeat
+            QVERIFY2(s.state == SmsSyncStatus::NeverAnswered, qPrintable(QStringLiteral("not warning at +%1 s").arg((s.t - connected) / 1000)));
+            QCOMPARE(s.text, samples.last().text); // and it does not change its story
+            ++warnings;
+        }
+    }
+    QVERIFY(warnings > 150);
+    QCOMPARE(keeper.unansweredSinceMs(), connected); // the first unanswered request, never moved
+    QVERIFY(keeper.lastRequestMs() > connected); // while the heartbeats kept asking
+    // Waiting, then NeverAnswered, and nothing else: one episode
+    QCOMPARE(states.count(), 2);
+    QCOMPARE(states.at(1).first().toInt(), int(SmsSyncStatus::NeverAnswered));
+}
+
+void SmsSyncStatusTest::testStoppedAnsweringWarningStaysUpUntilReply()
+{
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper keeper(0);
+    makeKeeper(keeper, true);
+    keeper.linkUp();
+    run(keeper, 12 * 60 * 1000);
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::Answered));
+    const qint64 lastAnswer = keeper.lastReplyMs();
+
+    // The phone goes silent (app force-stopped, link still up)
+    m_answers = false;
+    QSignalSpy states(&keeper, &SmsSyncKeeper::stateChanged);
+    const QList<Sample> silent = run(keeper, 31 * 60 * 1000);
+    const qint64 firstUnanswered = keeper.unansweredSinceMs();
+    QVERIFY(firstUnanswered > lastAnswer);
+    bool warned = false;
+    for (const Sample &s : silent) {
+        QVERIFY(!s.text.isEmpty());
+        if (s.t - firstUnanswered >= SmsSyncStatus::DEFAULT_STALE_AFTER_MS) {
+            QVERIFY2(s.state == SmsSyncStatus::Stale, qPrintable(QStringLiteral("gap at +%1 s").arg((s.t - firstUnanswered) / 1000)));
+            QVERIFY(s.text.contains(SmsHelper::shortTime(lastAnswer)));
+            warned = true;
+        } else if (warned) {
+            QFAIL("warning went away without a reply");
+        }
+    }
+    QVERIFY(warned);
+    QCOMPARE(states.count(), 1); // Answered -> Stale once, held through six heartbeats
+
+    // The phone answers again: the warning clears at once
+    m_answers = true;
+    keeper.heartbeat();
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::Answered));
+    QCOMPARE(keeper.unansweredSinceMs(), qint64(0));
+    QCOMPARE(states.count(), 2);
+}
+
+void SmsSyncStatusTest::testHealthyPhoneNeverWarns()
+{
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper keeper(0);
+    makeKeeper(keeper, true);
+    keeper.linkUp();
+    const QList<Sample> samples = run(keeper, 2 * 60 * 60 * 1000);
+    for (const Sample &s : samples) {
+        QCOMPARE(s.state, int(SmsSyncStatus::Answered));
+    }
+}
+
+void SmsSyncStatusTest::testReconnectGivesAFreshWindow()
+{
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper first(0);
+    makeKeeper(first, true);
+    first.linkUp();
+    run(first, 10 * 60 * 1000);
+
+    // Away for an hour; the plugin is recreated with the restored times
+    m_now += 60 * 60 * 1000;
+    m_lastBeat = m_now;
+    SmsSyncKeeper second(0, first.lastRequestMs(), first.lastReplyMs());
+    makeKeeper(second, false);
+    second.linkUp();
+    // The answer from the last connection does not count for this one...
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::Waiting));
+    // ...and after the window, it says the phone has not answered on this connection
+    run(second, 3 * 60 * 1000);
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::NeverAnswered));
+}
+
+void SmsSyncStatusTest::testWordingSaysWhatTheTimeMeans()
+{
+    const qint64 t = START;
+    QCOMPARE(SmsHelper::syncStatusText(SmsSyncStatus::Unknown, 0, 0, 0), QString());
+    // A keep-alive answer is not "last update": say only that the phone answered
+    const QString answered = SmsHelper::syncStatusText(SmsSyncStatus::Answered, t, 0, t);
+    QVERIFY(answered.startsWith(QStringLiteral("Phone answered at ")));
+    QVERIFY(!answered.contains(QStringLiteral("update"), Qt::CaseInsensitive));
+    QVERIFY(SmsHelper::syncStatusText(SmsSyncStatus::Waiting, 0, t, t).contains(QStringLiteral("waiting")));
+    QVERIFY(SmsHelper::syncStatusText(SmsSyncStatus::NeverAnswered, 0, t, t).startsWith(QStringLiteral("Not syncing")));
+    QVERIFY(SmsHelper::syncStatusText(SmsSyncStatus::Stale, t, t + 1, t).startsWith(QStringLiteral("Not syncing")));
+}
+
+void SmsSyncStatusTest::testFastLinkFlapStillWarns()
+{
+    // The link drops for 2 s every 60 s and the phone never answers. Each drop
+    // destroys the plugin (Device::reloadPlugins) and the next link makes a new
+    // one from the per-device store, exactly what SmsPlugin does. Before this
+    // fix every link-up restarted the 2 min window, so this never warned.
+    m_now = m_lastBeat = START;
+    qint64 lastRequest = 0, lastReply = 0, unanswered = 0, paused = 0, downAt = 0;
+    qint64 firstWarning = 0;
+    qint64 firstRequest = 0;
+    int samples = 0;
+    while (m_now - START < 10 * 60 * 1000) {
+        auto keeper = std::make_unique<SmsSyncKeeper>(0, lastRequest, lastReply);
+        makeKeeper(*keeper, false);
+        keeper->restoreUnanswered(unanswered, paused, downAt);
+        keeper->linkUp();
+        if (firstRequest == 0) {
+            firstRequest = keeper->unansweredSinceMs();
+        }
+        for (int step = 0; step < 4; ++step) {
+            const Sample s = appView(*keeper);
+            ++samples;
+            QVERIFY(!s.text.isEmpty());
+            if (SmsSyncStatus::isWarning(s.state)) {
+                if (firstWarning == 0) {
+                    firstWarning = s.t;
+                }
+            } else if (firstWarning != 0) {
+                QFAIL(qPrintable(QStringLiteral("warning went away at +%1 s without a reply").arg((s.t - START) / 1000)));
+            }
+            m_now += 14500;
+            keeper->checkState();
+        }
+        // The link drops: the plugin stores its clock and goes away
+        keeper->linkDown();
+        lastRequest = keeper->lastRequestMs();
+        lastReply = keeper->lastReplyMs();
+        unanswered = keeper->unansweredSinceMs();
+        paused = keeper->unansweredPausedMs();
+        downAt = keeper->linkDownAtMs();
+        QCOMPARE(unanswered, firstRequest); // never moved, never cleared
+        m_now += 2000;
+    }
+    QVERIFY(samples > 30);
+    QVERIFY2(firstWarning > 0, "a link flapping every 60 s with a silent phone never warned");
+    // About two minutes of connected silence, plus the few seconds spent disconnected
+    QVERIFY2(firstWarning - START <= SmsSyncStatus::DEFAULT_STALE_AFTER_MS + 30 * 1000, qPrintable(QString::number((firstWarning - START) / 1000)));
+}
+
+void SmsSyncStatusTest::testPhoneThatWasAwayGetsItsWindow()
+{
+    // A request was in flight when the phone left; it comes back an hour later.
+    // The hour does not count: the phone gets the rest of its window, no instant
+    // false alarm, and the clock still runs on from where it stopped.
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper first(0);
+    makeKeeper(first, false);
+    first.linkUp();
+    m_now += 30 * 1000;
+    first.checkState();
+    first.linkDown();
+    m_now += 60 * 60 * 1000;
+
+    SmsSyncKeeper second(0, first.lastRequestMs(), first.lastReplyMs());
+    makeKeeper(second, false);
+    second.restoreUnanswered(first.unansweredSinceMs(), first.unansweredPausedMs(), first.linkDownAtMs());
+    second.linkUp();
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::Waiting));
+    QCOMPARE(second.unansweredSinceMs(), first.unansweredSinceMs());
+    m_now += 80 * 1000; // 30 s + 80 s of connected silence: still inside the window
+    second.checkState();
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::Waiting));
+    m_now += 15 * 1000; // 125 s
+    second.checkState();
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::NeverAnswered));
+    QCOMPARE(int(second.state()), int(SmsSyncStatus::NeverAnswered)); // the daemon agrees
+}
+
+void SmsSyncStatusTest::testDebouncedLinkUpNeverReadsAnswered()
+{
+    // 1. A restored old answer and an unanswered request: a second link-up
+    //    inside the debounce window must not zero the clock or read as answered.
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper keeper(0, START - 60 * 60 * 1000, START - 60 * 60 * 1000);
+    makeKeeper(keeper, false);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1);
+    const qint64 asked = keeper.unansweredSinceMs();
+    QVERIFY(asked > 0);
+    m_now += 3000;
+    keeper.linkUp(); // debounced: no second full request
+    QCOMPARE(full.count(), 1);
+    QCOMPARE(keeper.unansweredSinceMs(), asked);
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::Waiting));
+    m_now += 2 * 60 * 1000;
+    keeper.checkState();
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::NeverAnswered));
+
+    // 2. The phone answered the first request, then a new link comes up inside
+    //    the window: that link has not answered yet, and its request is sent
+    //    when the window ends, not dropped.
+    m_now = m_lastBeat = START + 24 * 60 * 60 * 1000;
+    SmsSyncKeeper second(0);
+    makeKeeper(second, true);
+    QSignalSpy secondFull(&second, &SmsSyncKeeper::wantFullSync);
+    second.linkUp();
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::Answered));
+    m_answers = false;
+    m_now += 9800;
+    second.linkUp();
+    QCOMPARE(secondFull.count(), 1);
+    QVERIFY(second.unansweredSinceMs() > 0);
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::Waiting)); // not "answered" from the older reply
+    QVERIFY(secondFull.wait(3000)); // the deferred request goes out (200 ms later)
+    QCOMPARE(secondFull.count(), 2);
+    m_now += 2 * 60 * 1000;
+    second.checkState();
+    QCOMPARE(appView(second).state, int(SmsSyncStatus::NeverAnswered));
+}
+
+void SmsSyncStatusTest::testFailedSendsCountAsNotSyncing()
+{
+    // The link is up but every packet fails to go out: nothing is "unanswered"
+    // in the old sense, yet nothing syncs. That must warn too.
+    m_now = m_lastBeat = START;
+    SmsSyncKeeper keeper(0);
+    keeper.setClock([this]() {
+        return m_now;
+    });
+    keeper.setNewestThreadProvider([]() {
+        return qint64(42);
+    });
+    connect(&keeper, &SmsSyncKeeper::wantFullSync, &keeper, &SmsSyncKeeper::noteRequestFailed);
+    connect(&keeper, &SmsSyncKeeper::wantLightSync, &keeper, &SmsSyncKeeper::noteRequestFailed);
+    keeper.linkUp();
+    QCOMPARE(keeper.unansweredSinceMs(), START); // the first failed attempt starts the clock
+    QCOMPARE(keeper.lastRequestMs(), qint64(0)); // nothing was actually asked
+    QCOMPARE(appView(keeper).state, int(SmsSyncStatus::Waiting));
+    const QList<Sample> samples = run(keeper, 10 * 60 * 1000);
+    QCOMPARE(samples.last().state, int(SmsSyncStatus::NeverAnswered));
+    QVERIFY(!samples.last().text.isEmpty());
+    QCOMPARE(keeper.unansweredSinceMs(), START); // later failures do not move it
+}
+
+QTEST_GUILESS_MAIN(SmsSyncStatusTest)
+#include "smssyncstatustest.moc"
