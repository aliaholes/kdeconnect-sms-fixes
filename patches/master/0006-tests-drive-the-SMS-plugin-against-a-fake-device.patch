+/**
+ * Pasting into the SMS compose field (Ctrl+V and the right-click menu both call
+ * SendingArea's paste(), which asks SmsHelper): a bitmap is written to a PNG off
+ * the GUI thread, under the per-user runtime directory, and delivered later;
+ * text and anything else return 0 so a normal text paste happens.
+ */
+class SmsPasteTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void initTestCase();
+    void testBitmapIsSavedAsync();
+    void testTextIsNotAnAttachment();
+    void testBitmapWithTextPastesText();
+    void testImageFilesAreAttachedDirectly();
+    void testPasteDirIsPerUser();
+    void testSaveRunsOnAWorker();
+    void testSaveFailureIsReported();
+
+private:
+    QTemporaryDir m_runtime;
+    QTemporaryDir m_files;
+};
+
+void SmsPasteTest::initTestCase()
+{
+    QVERIFY(m_runtime.isValid());
+    QVERIFY(m_files.isValid());
+    QFile::setPermissions(m_runtime.path(), QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    qputenv("XDG_RUNTIME_DIR", m_runtime.path().toLocal8Bit());
+}
+
+void SmsPasteTest::testBitmapIsSavedAsync()
+{
+    SmsHelper helper;
+    QImage shot(1920, 1080, QImage::Format_RGB32);
+    shot.fill(Qt::darkCyan);
+    QGuiApplication::clipboard()->setImage(shot);
+    QVERIFY(helper.clipboardPasteable());
+
+    QSignalSpy ready(&helper, &SmsHelper::clipboardAttachmentsReady);
+    const int id = helper.pasteClipboardAttachments();
+    QVERIFY(id > 0);
+    QCOMPARE(ready.count(), 0); // not on this call: written in the background
+    QVERIFY(ready.wait(10000));
+    QCOMPARE(ready.first().at(0).toInt(), id);
+    const QList<QUrl> urls = ready.first().at(1).value<QList<QUrl>>();
+    QCOMPARE(urls.size(), 1);
+    const QString path = urls.first().toLocalFile();
+    QVERIFY2(path.startsWith(m_runtime.path() + QStringLiteral("/kdeconnect-sms-paste/")), qPrintable(path));
+    QImage back(path);
+    QCOMPARE(back.size(), shot.size());
+    QCOMPARE(QFileInfo(path).permissions() & (QFileDevice::ReadOther | QFileDevice::ReadGroup), QFileDevice::Permissions());
+}
+
+void SmsPasteTest::testTextIsNotAnAttachment()
+{
+    SmsHelper helper;
+    QGuiApplication::clipboard()->setText(QStringLiteral("hello there"));
+    QVERIFY(helper.clipboardPasteable());
+    QCOMPARE(helper.pasteClipboardAttachments(), 0);
+    QCOMPARE(helper.clipboardText(), QStringLiteral("hello there"));
+}
+
+void SmsPasteTest::testBitmapWithTextPastesText()
+{
+    SmsHelper helper;
+    auto *mime = new QMimeData;
+    QImage img(64, 64, QImage::Format_RGB32);
+    img.fill(Qt::red);
+    mime->setImageData(img);
+    mime->setText(QStringLiteral("a cell from a spreadsheet"));
+    QGuiApplication::clipboard()->setMimeData(mime);
+    QCOMPARE(helper.pasteClipboardAttachments(), 0);
+}
+
+void SmsPasteTest::testImageFilesAreAttachedDirectly()
+{
+    SmsHelper helper;
+    const QString a = m_files.filePath(QStringLiteral("a.png"));
+    const QString b = m_files.filePath(QStringLiteral("b.jpg"));
+    QImage img(32, 32, QImage::Format_RGB32);
+    img.fill(Qt::blue);
+    QVERIFY(img.save(a));
+    QVERIFY(img.save(b));
+    auto *mime = new QMimeData;
+    mime->setUrls({QUrl::fromLocalFile(a), QUrl::fromLocalFile(b)});
+    QGuiApplication::clipboard()->setMimeData(mime);
+
+    QSignalSpy ready(&helper, &SmsHelper::clipboardAttachmentsReady);
+    const int id = helper.pasteClipboardAttachments();
+    QVERIFY(id > 0);
+    QVERIFY(ready.wait(5000));
+    QCOMPARE(ready.first().at(0).toInt(), id);
+    QCOMPARE(ready.first().at(1).value<QList<QUrl>>(), (QList<QUrl>{QUrl::fromLocalFile(a), QUrl::fromLocalFile(b)}));
+}
+
+void SmsPasteTest::testPasteDirIsPerUser()
+{
+    QVERIFY(SmsHelper::pasteDirectory().startsWith(m_runtime.path()));
+    QVERIFY(!SmsHelper::pasteDirectory().startsWith(QStringLiteral("/tmp/kdeconnect")));
+    const QFileInfo dir(SmsHelper::pasteDirectory());
+    if (dir.exists()) {
+        QCOMPARE(dir.permissions() & (QFileDevice::ReadOther | QFileDevice::WriteOther | QFileDevice::ExeOther), QFileDevice::Permissions());
+    }
+}
+
+void SmsPasteTest::testSaveRunsOnAWorker()
+{
+    // The function the async paste hands to QtConcurrent works off the GUI thread
+    QImage img(800, 600, QImage::Format_ARGB32);
+    img.fill(Qt::transparent);
+    QThread *saver = nullptr;
+    QFuture<QUrl> future = QtConcurrent::run([&saver, img]() {
+        saver = QThread::currentThread();
+        return SmsHelper::savePastedImage(img, SmsHelper::pasteDirectory());
+    });
+    // Poll instead of result(): a blocking wait may run the task on this thread
+    QTRY_VERIFY_WITH_TIMEOUT(future.isFinished(), 10000);
+    QVERIFY(saver && saver != QThread::currentThread());
+    QVERIFY(QFileInfo::exists(future.result().toLocalFile()));
+}
+
+void SmsPasteTest::testSaveFailureIsReported()
+{
+    // The paste folder cannot be created (here: a plain file sits where the
+    // folder should be, which stops root too). The user must get a message,
+    // never a paste that silently does nothing.
+    QTemporaryDir broken;
+    QVERIFY(broken.isValid());
+    QFile::setPermissions(broken.path(), QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    QFile blocker(broken.filePath(QStringLiteral("kdeconnect-sms-paste")));
+    QVERIFY(blocker.open(QIODevice::WriteOnly));
+    blocker.close();
+
+    QString error;
+    QImage img(64, 64, QImage::Format_RGB32);
+    img.fill(Qt::green);
+    QVERIFY(SmsHelper::savePastedImage(img, blocker.fileName(), &error).isEmpty());
+    QVERIFY(!error.isEmpty());
+
+    const QByteArray oldRuntime = qgetenv("XDG_RUNTIME_DIR");
+    qputenv("XDG_RUNTIME_DIR", broken.path().toLocal8Bit());
+    QCOMPARE(SmsHelper::pasteDirectory(), blocker.fileName());
+
+    SmsHelper helper;
+    QGuiApplication::clipboard()->setImage(img);
+    QSignalSpy ready(&helper, &SmsHelper::clipboardAttachmentsReady);
+    QSignalSpy failed(&helper, &SmsHelper::clipboardPasteFailed);
+    const int id = helper.pasteClipboardAttachments();
+    QVERIFY(id > 0); // taken as an image paste, not as text
+    QVERIFY(failed.wait(10000));
+    qputenv("XDG_RUNTIME_DIR", oldRuntime);
+    QCOMPARE(failed.first().at(0).toInt(), id);
+    const QString message = failed.first().at(1).toString();
+    QVERIFY2(message.startsWith(QStringLiteral("Could not paste the image")), qPrintable(message));
+    QVERIFY2(message.contains(blocker.fileName()), qPrintable(message)); // says where
+    QCOMPARE(ready.count(), 0);
+}
+
+QTEST_MAIN(SmsPasteTest)
+#include "smspastetest.moc"
