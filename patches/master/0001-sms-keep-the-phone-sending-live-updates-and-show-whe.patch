+qint64 ConversationsDbusInterface::newestConversationId() const
+{
+    qint64 newestId = -1;
+    qint64 newestDate = std::numeric_limits<qint64>::min();
+    for (auto it = m_conversations.cbegin(); it != m_conversations.cend(); ++it) {
+        if (it.value().isEmpty()) {
+            continue;
+        }
+        const qint64 date = it.value().lastKey();
+        if (date > newestDate) {
+            newestDate = date;
+            newestId = it.key();
+        }
+    }
+    return newestId;
+}
+
+void ConversationsDbusInterface::setSyncStatus(qint64 lastRequestMs,
+                                               qint64 lastReplyMs,
+                                               qint64 unansweredSinceMs,
+                                               qint64 connectedSinceMs,
+                                               qint64 staleAfterMs,
+                                               int state,
+                                               qint64 unansweredPausedMs)
+{
+    m_lastSyncRequestMs = lastRequestMs;
+    m_lastSyncReplyMs = lastReplyMs;
+    m_syncUnansweredSinceMs = unansweredSinceMs;
+    m_syncConnectedSinceMs = connectedSinceMs;
+    m_syncStaleAfterMs = staleAfterMs;
+    m_syncUnansweredPausedMs = unansweredPausedMs;
+    m_syncState = state;
+    Q_EMIT syncStatusChanged();
+}
+
+QVariantMap ConversationsDbusInterface::syncStatus() const
+{
+    return {
+        {QStringLiteral("lastRequest"), m_lastSyncRequestMs},
+        {QStringLiteral("lastReply"), m_lastSyncReplyMs},
+        {QStringLiteral("unansweredSince"), m_syncUnansweredSinceMs},
+        {QStringLiteral("connectedSince"), m_syncConnectedSinceMs},
+        {QStringLiteral("staleAfter"), m_syncStaleAfterMs},
+        {QStringLiteral("unansweredPaused"), m_syncUnansweredPausedMs},
+        {QStringLiteral("state"), m_syncState},
+    };
+}
+
+qlonglong ConversationsDbusInterface::lastSyncRequest() const
+{
+    return m_lastSyncRequestMs;
+}
+
+qlonglong ConversationsDbusInterface::lastSyncReply() const
+{
+    return m_lastSyncReplyMs;
+}
