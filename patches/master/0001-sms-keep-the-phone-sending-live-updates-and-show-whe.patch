 K_PLUGIN_CLASS_WITH_JSON(SmsPlugin, "kdeconnect_sms.json")
 
+namespace
+{
+// The plugin is destroyed whenever the device goes away; keep the sync
+// timestamps per device for the lifetime of the daemon so the UI can still
+// say how long ago the phone last answered after a reconnect. The "not
+// syncing" notification lives here too: it is raised once per stale episode
+// and must be closable by whichever plugin instance sees the phone answer.
+struct DeviceSync {
+    qint64 lastRequestMs = 0;
+    qint64 lastReplyMs = 0;
+    // The unanswered clock outlives the plugin: a reconnect does not reset it
+    qint64 unansweredSinceMs = 0;
+    qint64 unansweredPausedMs = 0;
+    qint64 linkDownAtMs = 0;
+    bool stallNotified = false;
+    QPointer<KNotification> stallNotification;
+};
+QHash<QString, DeviceSync> &syncByDevice()
+{
+    static QHash<QString, DeviceSync> sync;
+    return sync;
+}
+
+QString shortTime(qint64 ms)
+{
+    const QDateTime when = QDateTime::fromMSecsSinceEpoch(ms);
+    if (when.date() == QDate::currentDate()) {
+        return QLocale().toString(when.time(), QLocale::ShortFormat);
+    }
+    return QLocale().toString(when, QLocale::ShortFormat);
+}
+
+constexpr int DEFAULT_HEARTBEAT_SECONDS = 300;
+constexpr int DEFAULT_FULL_SYNC_MINUTES = 30;
+constexpr int DEFAULT_STALE_SECONDS = SmsSyncStatus::DEFAULT_STALE_AFTER_MS / 1000;
+}
+
 SmsPlugin::SmsPlugin(QObject *parent, const QVariantList &args)
     : KdeConnectPlugin(parent, args)
     , m_conversationInterface(new ConversationsDbusInterface(this))
+    , m_deviceId(device()->id())
 {
+    const DeviceSync restored = syncByDevice().value(m_deviceId);
+    // Seconds between keep-alive requests to the phone; 0 disables the heartbeat
+    const int heartbeatSeconds = config()->getInt(QStringLiteral("syncHeartbeatSeconds"), DEFAULT_HEARTBEAT_SECONDS);
+    m_syncKeeper = new SmsSyncKeeper(heartbeatSeconds * 1000, restored.lastRequestMs, restored.lastReplyMs, this);
+    // Minutes between full re-reads of every thread on the heartbeat; 0 = only on connect
+    m_syncKeeper->setFullSyncIntervalMs(qint64(config()->getInt(QStringLiteral("syncFullSyncMinutes"), DEFAULT_FULL_SYNC_MINUTES)) * 60 * 1000);
+    // Seconds the phone may take to answer before we say sync has stopped
+    m_syncKeeper->setStaleAfterMs(qint64(config()->getInt(QStringLiteral("syncStaleSeconds"), DEFAULT_STALE_SECONDS)) * 1000);
+    m_syncKeeper->restoreUnanswered(restored.unansweredSinceMs, restored.unansweredPausedMs, restored.linkDownAtMs);
+    m_syncKeeper->setNewestThreadProvider([this]() {
+        return m_conversationInterface->newestConversationId();
+    });
+    connect(m_syncKeeper, &SmsSyncKeeper::wantFullSync, this, &SmsPlugin::requestAllConversations);
+    connect(m_syncKeeper, &SmsSyncKeeper::wantLightSync, this, [this](qint64 threadId) {
+        requestConversation(threadId, -1, 1);
+    });
+    connect(m_syncKeeper, &SmsSyncKeeper::statusChanged, this, [this]() {
+        storeSyncStatus();
+        publishSyncStatus();
+    });
+    connect(m_syncKeeper, &SmsSyncKeeper::stateChanged, this, [this](int state) {
+        publishSyncStatus();
+        updateStallNotification(state);
+    });
+    publishSyncStatus();
 }
 
 SmsPlugin::~SmsPlugin()
 {
+    // The plugin goes away when the device disconnects (or the plugin is
+    // disabled): remember when, so the disconnected time does not count
+    // against the phone, and keep the unanswered clock for the next link.
+    m_syncKeeper->linkDown();
+    storeSyncStatus();
+    // A persistent "not syncing" notification would go on claiming something
+    // about a phone we no longer talk to, and its actions would be dead.
+    // Close it; when the phone is back the new plugin decides afresh.
+    closeStallNotification();
     // m_conversationInterface is self-deleting, see ~ConversationsDbusInterface for more information
 }
 
+void SmsPlugin::storeSyncStatus()
+{
+    DeviceSync &sync = syncByDevice()[m_deviceId];
+    sync.lastRequestMs = m_syncKeeper->lastRequestMs();
+    sync.lastReplyMs = m_syncKeeper->lastReplyMs();
+    sync.unansweredSinceMs = m_syncKeeper->unansweredSinceMs();
+    sync.unansweredPausedMs = m_syncKeeper->unansweredPausedMs();
+    sync.linkDownAtMs = m_syncKeeper->linkDownAtMs();
+}
+
+void SmsPlugin::closeStallNotification()
+{
+    DeviceSync &sync = syncByDevice()[m_deviceId];
+    if (!sync.stallNotified) {
+        return;
+    }
+    sync.stallNotified = false;
+    if (KNotification *notification = sync.stallNotification) {
+        notification->close();
+        // A close() that lands while the notification server has not yet told
+        // KNotification its id is lost, and a "not updating" popup would stay
+        // up while messages flow again (seen when the phone answers right
+        // after a reconnect). Close once more after that round trip; the timer
+        // dies with the notification if the first close() already removed it.
+        QTimer::singleShot(1500, notification, [notification]() {
+            notification->close();
+        });
+    }
+    sync.stallNotification.clear();
+    Q_EMIT syncStallNotified(false);
+}
+
+void SmsPlugin::publishSyncStatus()
+{
+    m_conversationInterface->setSyncStatus(m_syncKeeper->lastRequestMs(),
+                                           m_syncKeeper->lastReplyMs(),
+                                           m_syncKeeper->unansweredSinceMs(),
+                                           m_syncKeeper->connectedSinceMs(),
+                                           m_syncKeeper->staleAfterMs(),
+                                           int(m_syncKeeper->state()),
+                                           m_syncKeeper->unansweredPausedMs());
+}
+
+void SmsPlugin::updateStallNotification(int state)
+{
+    DeviceSync &sync = syncByDevice()[m_deviceId];
+
+    if (state == SmsSyncStatus::Answered) {
+        // Recovered: take the warning away and allow a new one next time
+        closeStallNotification();
+        return;
+    }
+
+    // Once per stale episode: an episode only ends when the phone answers,
+    // so heartbeats and reconnects while it stays silent do not repeat it.
+    if (!SmsSyncStatus::isWarning(state) || sync.stallNotified) {
+        return;
+    }
+    sync.stallNotified = true;
+
+    QString text;
+    if (state == SmsSyncStatus::Stale) {
+        text = i18n("Text messages are not updating. The phone last answered at %1.", shortTime(m_syncKeeper->lastReplyMs()));
+    } else {
+        text = i18n("Text messages are not updating. The phone has not answered since it connected at %1.", shortTime(m_syncKeeper->connectedSinceMs()));
+    }
+    qCWarning(KDECONNECT_PLUGIN_SMS) << "SMS sync stalled for" << device()->name() << "state" << state;
+
+    auto *notification = new KNotification(QStringLiteral("smsSyncStalled"), KNotification::Persistent);
+    notification->setComponentName(QStringLiteral("kdeconnect"));
+    notification->setIconName(QStringLiteral("dialog-warning"));
+    notification->setTitle(device()->name());
+    notification->setText(text);
+    KNotificationAction *retry = notification->addAction(i18n("Retry"));
+    connect(retry, &KNotificationAction::activated, this, &SmsPlugin::requestAllConversations);
+    KNotificationAction *open = notification->addAction(i18n("Open Messages"));
+    connect(open, &KNotificationAction::activated, this, &SmsPlugin::launchApp);
+    sync.stallNotification = notification;
+    notification->sendEvent();
+    Q_EMIT syncStallNotificationCreated(notification);
+    Q_EMIT syncStallNotified(true);
+}
+
+void SmsPlugin::connected()
+{
+    // The phone only pushes new messages after it has been asked for
+    // messages since its SMS plugin was (re)created, and it does not tell us
+    // when that state is lost. Ask every time the link comes up.
+    m_syncKeeper->linkUp();
+    // The clock carries over from before a reconnect, so this link may start
+    // out in a warning; make sure the notification follows (once per episode).
+    updateStallNotification(int(m_syncKeeper->state()));
+}
+
 void SmsPlugin::receivePacket(const NetworkPacket &np)
 {
     if (np.type() == PACKET_TYPE_SMS_MESSAGES) {
+        m_syncKeeper->noteReply();
         handleBatchMessages(np);
     }
 
@@ -91,7 +264,13 @@ void SmsPlugin::requestAllConversations()
 {
     NetworkPacket np(PACKET_TYPE_SMS_REQUEST_CONVERSATIONS);
 
-    sendPacket(np);
+    if (sendPacket(np)) {
+        m_syncKeeper->noteRequest();
+    } else {
+        // Nothing went out, so nothing will come back: counts as not syncing too
+        qCWarning(KDECONNECT_PLUGIN_SMS) << "Could not send the conversations request to" << m_deviceId;
+        m_syncKeeper->noteRequestFailed();
+    }
 }
 
