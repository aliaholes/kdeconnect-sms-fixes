+
+#include "plugins/sms/smssynckeeper.h"
+
+#include <QSignalSpy>
+#include <QTest>
+
+/**
+ * The phone stops pushing new messages after any reconnect until it is asked
+ * again. These tests drive SmsSyncKeeper the way SmsPlugin does: linkUp() from
+ * KdeConnectPlugin::connected(), noteRequest() when a request packet went out,
+ * noteReply() when a kdeconnect.sms.messages packet came in.
+ */
+class SmsSyncKeeperTest : public QObject
+{
+    Q_OBJECT
+
+private Q_SLOTS:
+    void testFullRequestOnLinkUp();
+    void testReconnectAsksAgain();
+    void testBurstOfLinkUpsIsOneRequest();
+    void testHeartbeatIsLightWhenAnswered();
+    void testHeartbeatFallsBackToFullWhenUnanswered();
+    void testHeartbeatFullWhenNoThreadKnown();
+    void testHeartbeatDisabled();
+    void testPeriodicFullSync();
+    void testStatusSignal();
+};
+
+// Simulates the plugin: answers every request like a healthy phone would
+static void wireHealthyPhone(SmsSyncKeeper &keeper)
+{
+    QObject::connect(&keeper, &SmsSyncKeeper::wantFullSync, &keeper, [&keeper]() {
+        keeper.noteRequest();
+        keeper.noteReply();
+    });
+    QObject::connect(&keeper, &SmsSyncKeeper::wantLightSync, &keeper, [&keeper](qint64) {
+        keeper.noteRequest();
+        keeper.noteReply();
+    });
+}
+
+void SmsSyncKeeperTest::testFullRequestOnLinkUp()
+{
+    SmsSyncKeeper keeper(60 * 1000);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1);
+}
+
+void SmsSyncKeeperTest::testReconnectAsksAgain()
+{
+    // The plugin is recreated on every reconnect: a new keeper, restored times
+    SmsSyncKeeper first(60 * 1000);
+    QSignalSpy firstFull(&first, &SmsSyncKeeper::wantFullSync);
+    first.linkUp();
+    QCOMPARE(firstFull.count(), 1);
+
+    SmsSyncKeeper second(60 * 1000, first.lastRequestMs(), first.lastReplyMs());
+    QSignalSpy secondFull(&second, &SmsSyncKeeper::wantFullSync);
+    second.linkUp();
+    QCOMPARE(secondFull.count(), 1);
+}
+
+void SmsSyncKeeperTest::testBurstOfLinkUpsIsOneRequest()
+{
+    SmsSyncKeeper keeper(60 * 1000);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    keeper.linkUp();
+    keeper.linkUp();
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1);
+}
+
+void SmsSyncKeeperTest::testHeartbeatIsLightWhenAnswered()
+{
+    SmsSyncKeeper keeper(100);
+    keeper.setNewestThreadProvider([]() {
+        return qint64(1234);
+    });
+    wireHealthyPhone(keeper);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    QSignalSpy light(&keeper, &SmsSyncKeeper::wantLightSync);
+
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1);
+    QVERIFY(light.wait(1000));
+    QCOMPARE(light.first().first().toLongLong(), qint64(1234));
+    QCOMPARE(full.count(), 1); // the heartbeat did not re-read every thread
+    QVERIFY(light.wait(1000)); // and it keeps beating
+}
+
+void SmsSyncKeeperTest::testHeartbeatFallsBackToFullWhenUnanswered()
+{
+    SmsSyncKeeper keeper(100);
+    keeper.setNewestThreadProvider([]() {
+        return qint64(1234);
+    });
+    // A phone that never answers: requests go out, no reply comes back
+    connect(&keeper, &SmsSyncKeeper::wantFullSync, &keeper, &SmsSyncKeeper::noteRequest);
+    connect(&keeper, &SmsSyncKeeper::wantLightSync, &keeper, &SmsSyncKeeper::noteRequest);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    QSignalSpy light(&keeper, &SmsSyncKeeper::wantLightSync);
+
+    keeper.linkUp();
+    QVERIFY(full.wait(1000)); // the next heartbeat asks for everything again
+    QCOMPARE(full.count(), 2);
+    QCOMPARE(light.count(), 0);
+    QVERIFY(keeper.lastReplyMs() < keeper.lastRequestMs());
+}
+
+void SmsSyncKeeperTest::testHeartbeatFullWhenNoThreadKnown()
+{
+    SmsSyncKeeper keeper(100);
+    keeper.setNewestThreadProvider([]() {
+        return qint64(-1);
+    });
+    wireHealthyPhone(keeper);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    QSignalSpy light(&keeper, &SmsSyncKeeper::wantLightSync);
+    keeper.linkUp();
+    QVERIFY(full.wait(1000));
+    QCOMPARE(light.count(), 0);
+}
+
+void SmsSyncKeeperTest::testHeartbeatDisabled()
+{
+    SmsSyncKeeper keeper(0);
+    wireHealthyPhone(keeper);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    QSignalSpy light(&keeper, &SmsSyncKeeper::wantLightSync);
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1); // still asks on connect
+    QTest::qWait(300);
+    QCOMPARE(full.count(), 1);
+    QCOMPARE(light.count(), 0);
+}
+
+void SmsSyncKeeperTest::testPeriodicFullSync()
+{
+    SmsSyncKeeper keeper(100);
+    keeper.setFullSyncIntervalMs(350);
+    keeper.setNewestThreadProvider([]() {
+        return qint64(1234);
+    });
+    wireHealthyPhone(keeper);
+    QSignalSpy full(&keeper, &SmsSyncKeeper::wantFullSync);
+    QSignalSpy light(&keeper, &SmsSyncKeeper::wantLightSync);
+    keeper.linkUp();
+    QCOMPARE(full.count(), 1);
+    QVERIFY(full.wait(1500)); // a full re-read comes back around even though every request was answered
+    QVERIFY(light.count() >= 2); // and light beats in between
+}
+
+void SmsSyncKeeperTest::testStatusSignal()
+{
+    SmsSyncKeeper keeper(0);
+    QSignalSpy status(&keeper, &SmsSyncKeeper::statusChanged);
+    keeper.noteRequest();
+    QCOMPARE(status.count(), 1);
+    QVERIFY(status.last().at(0).toLongLong() > 0);
+    QCOMPARE(status.last().at(1).toLongLong(), qint64(0));
+    keeper.noteReply();
+    QCOMPARE(status.count(), 2);
+    QVERIFY(status.last().at(1).toLongLong() >= status.last().at(0).toLongLong());
+}
+
+QTEST_GUILESS_MAIN(SmsSyncKeeperTest)
+#include "smssynckeepertest.moc"
