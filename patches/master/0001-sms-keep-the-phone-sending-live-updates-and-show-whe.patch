@@ -101,7 +280,12 @@ void SmsPlugin::requestConversation(const qint64 conversationID, const qint64 ra
     np.set(QStringLiteral("rangeStartTimestamp"), rangeStartTimestamp);
     np.set(QStringLiteral("numberToRequest"), numberToRequest);
 
-    sendPacket(np);
+    if (sendPacket(np)) {
+        m_syncKeeper->noteRequest();
+    } else {
+        qCWarning(KDECONNECT_PLUGIN_SMS) << "Could not send the conversation request to" << m_deviceId;
+        m_syncKeeper->noteRequestFailed();
+    }
 }
 
