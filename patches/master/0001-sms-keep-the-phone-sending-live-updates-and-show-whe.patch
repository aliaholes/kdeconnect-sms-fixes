+void ConversationListModel::fetchSyncStatus()
+{
+    if (!m_conversationsInterface) {
+        return;
+    }
+    // An older daemon does not have this method; the reply then carries an error and we show nothing
+    const QDBusPendingReply<QVariantMap> reply = m_conversationsInterface->syncStatus();
+    setWhenAvailable(
+        reply,
+        [this](bool error, const QVariantMap &status) {
+            if (!error) {
+                handleSyncStatus(status);
+            }
+        },
+        this);
+}
+
+void ConversationListModel::handleSyncStatus(const QVariantMap &status)
+{
+    m_lastSyncReplyMs = status.value(QStringLiteral("lastReply")).toLongLong();
+    m_syncUnansweredSinceMs = status.value(QStringLiteral("unansweredSince")).toLongLong();
+    m_syncConnectedSinceMs = status.value(QStringLiteral("connectedSince")).toLongLong();
+    m_syncStaleAfterMs = status.value(QStringLiteral("staleAfter")).toLongLong();
+    m_syncUnansweredPausedMs = status.value(QStringLiteral("unansweredPaused")).toLongLong();
+    updateSyncStatusText();
+}
+
+void ConversationListModel::updateSyncStatusText()
+{
+    // The same rule the daemon uses for its notification, re-evaluated here on
+    // our own timer so the line turns into a warning even if nothing arrives.
+    const qint64 staleAfter = m_syncStaleAfterMs > 0 ? m_syncStaleAfterMs : SmsSyncStatus::DEFAULT_STALE_AFTER_MS;
+    const int state = SmsSyncStatus::evaluate(QDateTime::currentMSecsSinceEpoch(),
+                                              m_syncUnansweredSinceMs,
+                                              m_lastSyncReplyMs,
+                                              m_syncConnectedSinceMs,
+                                              staleAfter,
+                                              m_syncUnansweredPausedMs);
+    const bool stale = SmsSyncStatus::isWarning(state);
+    const QString text = SmsHelper::syncStatusText(state, m_lastSyncReplyMs, m_syncUnansweredSinceMs, m_syncConnectedSinceMs);
+
+    if (text != m_syncStatusText || stale != m_syncStale) {
+        m_syncStatusText = text;
+        m_syncStale = stale;
+        Q_EMIT syncStatusChanged();
+    }
+}
+
