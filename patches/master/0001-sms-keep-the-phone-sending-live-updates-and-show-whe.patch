new file mode 100644
index 0000000..5496ef6
--- /dev/null
+++ b/plugins/sms/smssynckeeper.cpp
@@ -0,0 +1,206 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Alia Holes <thealiaholes@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "smssynckeeper.h"
+
+#include <QDateTime>
+
+namespace
+{
+int stateCheckIntervalMs(qint64 staleAfterMs)
+{
+    // Often enough that a warning shows up soon after the window ends
+    return int(qBound(qint64(250), staleAfterMs / 4, qint64(15 * 1000)));
+}
+}
+
+SmsSyncKeeper::SmsSyncKeeper(int heartbeatMs, qint64 lastRequestMs, qint64 lastReplyMs, QObject *parent)
+    : QObject(parent)
+    , m_lastRequestMs(lastRequestMs)
+    , m_lastReplyMs(lastReplyMs)
+{
+    m_heartbeat.setInterval(heartbeatMs > 0 ? heartbeatMs : 0);
+    m_heartbeat.setSingleShot(false);
+    connect(&m_heartbeat, &QTimer::timeout, this, &SmsSyncKeeper::heartbeat);
+
+    // Staleness depends on the clock, not only on packets: nothing arriving
+    // is exactly the case that must still change the state.
+    m_stateCheck.setInterval(stateCheckIntervalMs(m_staleAfterMs));
+    connect(&m_stateCheck, &QTimer::timeout, this, &SmsSyncKeeper::checkState);
+    m_stateCheck.start();
+
+    // A link-up inside the debounce window does not drop its request: it is
+    // sent when the window ends.
+    m_deferredFull.setSingleShot(true);
+    connect(&m_deferredFull, &QTimer::timeout, this, [this]() {
+        requestFull();
+        checkState();
+    });
+}
+
+void SmsSyncKeeper::setFullSyncIntervalMs(qint64 intervalMs)
+{
+    m_fullSyncIntervalMs = intervalMs;
+}
+
+void SmsSyncKeeper::setStaleAfterMs(qint64 staleAfterMs)
+{
+    m_staleAfterMs = staleAfterMs > 0 ? staleAfterMs : SmsSyncStatus::DEFAULT_STALE_AFTER_MS;
+    m_stateCheck.setInterval(stateCheckIntervalMs(m_staleAfterMs));
+    checkState();
+}
+
+void SmsSyncKeeper::setNewestThreadProvider(std::function<qint64()> provider)
+{
+    m_newestThread = std::move(provider);
+}
+
+void SmsSyncKeeper::setClock(std::function<qint64()> clock)
+{
+    m_clock = std::move(clock);
+}
+
+qint64 SmsSyncKeeper::now() const
+{
+    return m_clock ? m_clock() : QDateTime::currentMSecsSinceEpoch();
+}
+
+void SmsSyncKeeper::restoreUnanswered(qint64 unansweredSinceMs, qint64 pausedMs, qint64 linkDownAtMs)
+{
+    if (unansweredSinceMs <= 0) {
+        return;
+    }
+    m_unansweredSinceMs = unansweredSinceMs;
+    m_unansweredPausedMs = qMax(qint64(0), pausedMs);
+    m_linkDownAtMs = qMax(qint64(0), linkDownAtMs);
+    // Not evaluated here: the owner connects to stateChanged after restoring,
+    // and linkUp() evaluates (and announces) the state for the new link.
+}
+
+void SmsSyncKeeper::linkDown()
+{
+    m_heartbeat.stop();
+    m_deferredFull.stop();
+    if (m_linkDownAtMs == 0) {
+        m_linkDownAtMs = now();
+    }
+}
+
+void SmsSyncKeeper::startUnanswered()
+{
+    if (m_unansweredSinceMs == 0) {
+        m_unansweredSinceMs = now();
+        m_unansweredPausedMs = 0;
+    }
+}
+
+void SmsSyncKeeper::linkUp()
+{
+    const qint64 t = now();
+    // Whether the phone has answered on this link is judged against this
+    // time. The unanswered clock is NOT reset: only a reply clears it, so a
+    // link that drops and comes back faster than the window still warns.
+    // Only the time it spent disconnected is left out.
+    m_connectedSinceMs = t;
+    if (m_linkDownAtMs > 0) {
+        if (m_unansweredSinceMs > 0 && t > m_linkDownAtMs) {
+            m_unansweredPausedMs += t - qMax(m_linkDownAtMs, m_unansweredSinceMs);
+        }
+        m_linkDownAtMs = 0;
+    }
+
+    // A full request reads every thread on the phone, so fold bursts of
+    // link-up events (reloadPlugins runs once per link change) into one.
+    if (m_lastFullMs == 0 || t - m_lastFullMs >= FULL_REQUEST_DEBOUNCE_MS) {
+        m_deferredFull.stop();
+        requestFull();
+    } else if (m_unansweredSinceMs == 0) {
+        // Skipped, but the last full request was already answered, before this
+        // link came up: an older reply must not make this link read as
+        // answered. It owes us an answer (the clock starts now), and the
+        // request goes out when the debounce window ends instead of never.
+        startUnanswered();
+        Q_EMIT statusChanged(m_lastRequestMs, m_lastReplyMs);
+        if (!m_deferredFull.isActive()) {
+            m_deferredFull.start(int(qMax(qint64(0), m_lastFullMs + FULL_REQUEST_DEBOUNCE_MS - t)));
+        }
+    }
+    // (Skipped while the last request is still unanswered: that request is
+    // still out, and its clock keeps running.)
+    if (m_heartbeat.interval() > 0) {
+        m_heartbeat.start();
+    }
+    checkState();
+}
+
+void SmsSyncKeeper::noteRequest()
+{
+    m_lastRequestMs = now();
+    // Keep the FIRST unanswered request: later heartbeats must not restart
+    // the clock, or the warning would come and go while the phone stays silent.
+    if (m_unansweredSinceMs == 0) {
+        m_unansweredSinceMs = m_lastRequestMs;
+    }
+    Q_EMIT statusChanged(m_lastRequestMs, m_lastReplyMs);
+    checkState();
+}
+
+void SmsSyncKeeper::noteRequestFailed()
+{
+    // Nothing reached the phone, so nothing can come back: that is as much
+    // "not syncing" as a request it ignores.
+    startUnanswered();
+    Q_EMIT statusChanged(m_lastRequestMs, m_lastReplyMs);
+    checkState();
+}
+
+void SmsSyncKeeper::noteReply()
+{
+    m_lastReplyMs = now();
+    m_unansweredSinceMs = 0;
+    m_unansweredPausedMs = 0;
+    Q_EMIT statusChanged(m_lastRequestMs, m_lastReplyMs);
+    checkState();
+}
+
+void SmsSyncKeeper::checkState()
+{
+    // While the link is down the clock is paused: count up to linkDown() only
+    const qint64 at = m_linkDownAtMs > 0 ? m_linkDownAtMs : now();
+    const SmsSyncStatus::State state =
+        SmsSyncStatus::evaluate(at, m_unansweredSinceMs, m_lastReplyMs, m_connectedSinceMs, m_staleAfterMs, m_unansweredPausedMs);
+    if (state != m_state) {
+        m_state = state;
+        Q_EMIT stateChanged(int(state));
+    }
+}
+
+void SmsSyncKeeper::requestFull()
+{
+    m_lastFullMs = now();
+    Q_EMIT wantFullSync();
+}
+
+void SmsSyncKeeper::heartbeat()
+{
+    // A request is still unanswered: the phone side may have been recreated,
+    // ask for everything again instead of just one thread.
+    const bool unanswered = m_unansweredSinceMs > 0;
+    const qint64 newest = m_newestThread ? m_newestThread() : -1;
+    const bool fullDue = m_fullSyncIntervalMs > 0 && now() - m_lastFullMs >= m_fullSyncIntervalMs;
+
+    if (unanswered || newest < 0 || fullDue) {
+        requestFull();
+    } else {
+        // request_conversation sets the same "messages requested" flag on the
+        // phone as request_conversations, but reads one thread, one message,
+        // and always gets exactly one reply packet back.
+        Q_EMIT wantLightSync(newest);
+    }
+    checkState();
+}
+
+#include "moc_smssynckeeper.cpp"
diff --git a/plugins/sms/smssynckeeper.h b/plugins/sms/smssynckeeper.h
new file mode 100644
index 0000000..4363e48
--- /dev/null
+++ b/plugins/sms/smssynckeeper.h
@@ -0,0 +1,172 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Alia Holes <thealiaholes@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QObject>
+#include <QTimer>
+
+#include <functional>
+
+#include "smssyncstatus.h"
+
+/**
+ * Keeps the phone's SMS plugin pushing live updates.
+ *
+ * The Android app only forwards new messages after it has received a
+ * request_conversations or request_conversation packet during the current
+ * lifetime of its SMS plugin. That flag lives in memory on the phone, so a
+ * reconnect, a phone-side plugin restart or an app update silently stops
+ * all live updates until the desktop asks again.
+ *
+ * This class decides when to ask:
+ *  - a full request (request_conversations) whenever the link comes up,
+ *  - a light request (request_conversation for the newest known thread,
+ *    one message) on a heartbeat,
+ *  - a full request on the heartbeat instead when no thread is known yet,
+ *    when the previous request went unanswered, or when the last full
+ *    request is older than the full-sync interval (this catches a phone that
+ *    still answers requests but whose live updates broke).
+ *
+ * It also records when we last asked, the first request that is still
+ * unanswered, and when the phone last answered, and turns them into an
+ * SmsSyncStatus::State, so the UI and the desktop notification can show that
+ * sync has stopped instead of staying silent. Only a reply from the phone
+ * clears the unanswered clock: not a reconnect, not a skipped request, and a
+ * request that could not be sent starts it like one that went unanswered.
+ */
+class SmsSyncKeeper : public QObject
+{
+    Q_OBJECT
+
+public:
+    /**
+     * @param heartbeatMs interval of the light heartbeat; <= 0 disables the heartbeat
+     * @param lastRequestMs, lastReplyMs restored state (ms since epoch, 0 = never)
+     */
+    explicit SmsSyncKeeper(int heartbeatMs, qint64 lastRequestMs = 0, qint64 lastReplyMs = 0, QObject *parent = nullptr);
+
+    /** On the heartbeat, ask for everything again when the last full request is older than this; <= 0 = never */
+    void setFullSyncIntervalMs(qint64 intervalMs);
+
+    /** How long the phone may take to answer before the state turns into a warning */
+    void setStaleAfterMs(qint64 staleAfterMs);
+
+    /** Returns the newest known thread ID, or a negative value when none is known */
+    void setNewestThreadProvider(std::function<qint64()> provider);
+
+    /** Replace the wall clock (ms since epoch); for tests */
+    void setClock(std::function<qint64()> clock);
+
+    /**
+     * Carry the unanswered clock over from the previous plugin instance (the
+     * plugin is recreated on every reconnect).
+     * @param unansweredSinceMs the first unanswered request, 0 = none
+     * @param pausedMs disconnected time already excluded from it
+     * @param linkDownAtMs when the previous link went down, 0 = unknown; the time
+     *        until the next linkUp() is excluded too
+     */
+    void restoreUnanswered(qint64 unansweredSinceMs, qint64 pausedMs, qint64 linkDownAtMs);
+
+    /** The link to the phone is (again) usable */
+    void linkUp();
+
+    /** The link to the phone went away; time until the next linkUp() does not count as unanswered */
+    void linkDown();
+
+    /** A request was sent to the phone (by us or by anybody else) */
+    void noteRequest();
+
+    /** A request (or message) could not be handed to the link at all: counts as unanswered from now on */
+    void noteRequestFailed();
+
+    /** A packet with messages arrived from the phone */
+    void noteReply();
+
+    /** What the heartbeat timer runs; public so tests can drive it with a fake clock */
+    void heartbeat();
+
+    /** Re-evaluate the state against the clock; runs on its own timer while the link is up */
+    void checkState();
+
+    qint64 lastRequestMs() const
+    {
+        return m_lastRequestMs;
+    }
+    qint64 lastReplyMs() const
+    {
+        return m_lastReplyMs;
+    }
+    /** The first request that is still unanswered, 0 when every request was answered */
+    qint64 unansweredSinceMs() const
+    {
+        return m_unansweredSinceMs;
+    }
+    /** When linkUp() last ran, 0 before the first link */
+    qint64 connectedSinceMs() const
+    {
+        return m_connectedSinceMs;
+    }
+    /** Disconnected time inside the current unanswered stretch (not counted against the phone) */
+    qint64 unansweredPausedMs() const
+    {
+        return m_unansweredPausedMs;
+    }
+    /** When linkDown() ran, 0 while the link is up */
+    qint64 linkDownAtMs() const
+    {
+        return m_linkDownAtMs;
+    }
+    /** The keeper's clock (the wall clock unless a test replaced it) */
+    qint64 nowMs() const
+    {
+        return now();
+    }
+    qint64 staleAfterMs() const
+    {
+        return m_staleAfterMs;
+    }
+    SmsSyncStatus::State state() const
+    {
+        return m_state;
+    }
+    int heartbeatMs() const
+    {
+        return m_heartbeat.interval();
+    }
+
+    /** Requests sent less than this long after a full request are folded into it */
+    static constexpr qint64 FULL_REQUEST_DEBOUNCE_MS = 10 * 1000;
+
+Q_SIGNALS:
+    void wantFullSync();
+    void wantLightSync(qint64 threadId);
+    /** Any of the recorded times changed */
+    void statusChanged(qint64 lastRequestMs, qint64 lastReplyMs);
+    /** The evaluated state changed (an SmsSyncStatus::State) */
+    void stateChanged(int state);
+
+private:
+    void requestFull();
+    void startUnanswered();
+    qint64 now() const;
+
+    QTimer m_heartbeat;
+    QTimer m_stateCheck;
+    QTimer m_deferredFull;
+    std::function<qint64()> m_newestThread;
+    std::function<qint64()> m_clock;
+    qint64 m_lastRequestMs;
+    qint64 m_lastReplyMs;
+    qint64 m_unansweredSinceMs = 0;
+    qint64 m_connectedSinceMs = 0;
+    qint64 m_unansweredPausedMs = 0;
+    qint64 m_linkDownAtMs = 0;
+    qint64 m_lastFullMs = 0;
+    qint64 m_fullSyncIntervalMs = 0;
+    qint64 m_staleAfterMs = SmsSyncStatus::DEFAULT_STALE_AFTER_MS;
+    SmsSyncStatus::State m_state = SmsSyncStatus::Unknown;
+};
diff --git a/plugins/sms/smssyncstatus.h b/plugins/sms/smssyncstatus.h
new file mode 100644
index 0000000..e589754
--- /dev/null
+++ b/plugins/sms/smssyncstatus.h
@@ -0,0 +1,69 @@
+/**
+ * SPDX-FileCopyrightText: 2026 Alia Holes <thealiaholes@gmail.com>
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QtGlobal>
+
+/**
+ * One rule for "is the phone still sending us messages?", shared by the
+ * daemon (which raises a desktop notification) and the SMS app (which shows
+ * the status line), so both always agree.
+ *
+ * The inputs are the times SmsSyncKeeper records (ms since epoch, 0 = never):
+ *  - unansweredSinceMs: the FIRST request the phone has not answered yet.
+ *    Later unanswered requests do not move it; only a reply clears it. A
+ *    request that could not even be sent starts it too. It survives
+ *    reconnects: a link that drops and comes back while the phone stays
+ *    silent keeps the same clock, so fast flapping still warns.
+ *  - lastReplyMs: when the phone last sent any messages packet.
+ *  - connectedSinceMs: when the current link to the phone came up (for the
+ *    wording, and to tell an answer on this link from an older one).
+ *  - unansweredPausedMs: time the phone spent disconnected while a request
+ *    was unanswered; it does not count, so a phone that was simply away
+ *    gets its window when it comes back instead of an instant warning.
+ */
+namespace SmsSyncStatus
+{
+enum State {
+    /** Nothing asked and nothing heard yet */
+    Unknown = 0,
+    /** The phone answered, and no request is overdue */
+    Answered = 1,
+    /** Asked since this connection came up, no answer yet, still inside the window */
+    Waiting = 2,
+    /** The phone has not answered anything since this connection came up, past the window */
+    NeverAnswered = 3,
+    /** The phone answered earlier on this connection, then stopped answering, past the window */
+    Stale = 4,
+};
+
+/** How long the phone may take to answer before sync counts as stopped */
+constexpr qint64 DEFAULT_STALE_AFTER_MS = 2 * 60 * 1000;
+
+inline State evaluate(qint64 nowMs,
+                      qint64 unansweredSinceMs,
+                      qint64 lastReplyMs,
+                      qint64 connectedSinceMs,
+                      qint64 staleAfterMs = DEFAULT_STALE_AFTER_MS,
+                      qint64 unansweredPausedMs = 0)
+{
+    const bool answeredThisLink = lastReplyMs > 0 && lastReplyMs >= connectedSinceMs;
+    if (unansweredSinceMs <= 0) {
+        return lastReplyMs > 0 ? Answered : Unknown;
+    }
+    if (nowMs - unansweredSinceMs - qMax(qint64(0), unansweredPausedMs) < staleAfterMs) {
+        return answeredThisLink ? Answered : Waiting;
+    }
+    return answeredThisLink ? Stale : NeverAnswered;
+}
+
+/** States in which the user must be told that messages are not arriving */
+inline bool isWarning(int state)
+{
+    return state == NeverAnswered || state == Stale;
+}
+}
