+QString SmsHelper::shortTime(qint64 msSinceEpoch)
+{
+    const QDateTime when = QDateTime::fromMSecsSinceEpoch(msSinceEpoch);
+    if (when.date() == QDate::currentDate()) {
+        return QLocale().toString(when.time(), QLocale::ShortFormat);
+    }
+    return QLocale().toString(when, QLocale::ShortFormat);
+}
+
+QString SmsHelper::syncStatusText(int state, qint64 lastReplyMs, qint64 unansweredSinceMs, qint64 connectedSinceMs)
+{
+    switch (state) {
+    case SmsSyncStatus::Answered:
+        // Only that the phone answered: a keep-alive answer does not prove every thread is current
+        return i18nd("kdeconnect-sms", "Phone answered at %1", shortTime(lastReplyMs));
+    case SmsSyncStatus::Waiting:
+        return i18nd("kdeconnect-sms", "Asked the phone for messages at %1, waiting for its answer", shortTime(unansweredSinceMs));
+    case SmsSyncStatus::NeverAnswered:
+        return i18nd("kdeconnect-sms",
+                     "Not syncing: the phone has not answered since it connected at %1",
+                     shortTime(connectedSinceMs > 0 ? connectedSinceMs : unansweredSinceMs));
+    case SmsSyncStatus::Stale:
+        return i18nd("kdeconnect-sms", "Not syncing: the phone last answered at %1", shortTime(lastReplyMs));
+    default:
+        return QString();
+    }
+}
